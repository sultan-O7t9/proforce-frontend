---
import { twMerge } from "tailwind-merge";

interface Props {
  label: string;
  href: string;
  className?: string;
  variant?: "outlined" | "filled";
}
const { label, href, className, variant = "filled" } = Astro.props;
---

<a
  href={href}
  data-variant={variant}
  class={twMerge(
    "cursor-pointer overflow-hidden block text-[clamp(0.75rem,1.3vw,1rem)] uppercase tracking-[1%] whitespace-nowrap px-[clamp(1.25rem,2.2vw,1.9rem)] py-[clamp(0.5rem,1.2vw,0.75rem)] rounded-full border border-pf-yellow relative btn-cta group transition-[background-color,color,border-color] duration-200 ease-in backdrop-blur-[10px]",
    // Base Outlined Styles (Default when variant is "outlined")
    "text-pf-yellow bg-[rgba(6,10,20,0.1)] hover:text-pf-navy",
    // Filled Styles Modifier (or toggled via data attribute when scrolled)
    "data-[variant=filled]:bg-pf-yellow data-[variant=filled]:text-pf-navy data-[variant=filled]:hover:bg-pf-navy data-[variant=filled]:hover:text-pf-yellow data-[variant=filled]:hover:border-pf-navy data-[variant=filled]:backdrop-blur-none",
    className,
  )}
>
  <div
    class={twMerge(
      "hidden md:block rounded-full circle-util aspect-square w-[200%] absolute z-0 top-0 left-0 scale-0 pointer-events-none -translate-x-1/2 -translate-y-1/2",
      // Background color of the hover circle changes depending on variant
      "bg-pf-yellow group-data-[variant=filled]:bg-pf-navy",
    )}
  >
  </div>
  <span
    class={twMerge(
      "pointer-events-none relative z-10 text-pf-yellow group-hover:text-pf-navy",
      "group-data-[variant=filled]:text-pf-navy group-data-[variant=filled]:group-hover:text-pf-yellow",
    )}
  >
    {label}
  </span>
</a>

<script>
  import { gsap } from "../../lib/gsap";

  document.addEventListener("DOMContentLoaded", () => {
    // 1. Listen for the header scroll state change to dynamically switch variants on light theme
    const headerCta = document.querySelector(".header-cta-button");
    if (headerCta) {
      const observer = new MutationObserver(() => {
        if (headerCta.hasAttribute("data-scrolled")) {
          headerCta.setAttribute("data-variant", "filled");
        } else {
          headerCta.setAttribute("data-variant", "outlined");
        }
      });
      observer.observe(headerCta, {
        attributes: true,
        attributeFilter: ["data-scrolled"],
      });
    }

    // 2. Button Hover Effect
    const buttons = document.querySelectorAll(
      ".btn-cta",
    ) as NodeListOf<HTMLAnchorElement>;

    buttons.forEach((btnCta) => {
      const circle = btnCta?.querySelector(
        ".circle-util",
      ) as HTMLElement | null;

      if (btnCta && circle) {
        const animation = gsap.to(circle, {
          scale: 2,
          duration: 0.5,
          ease: "power1.in",
          paused: true,
        });

        btnCta?.addEventListener("mouseover", (e: MouseEvent) => {
          const dimensions = btnCta.getBoundingClientRect();

          circle.style.top = `${e.clientY - dimensions.top}px`;
          circle.style.left = `${e.clientX - dimensions.left}px`;
          animation.play();
        });

        btnCta.addEventListener("mouseleave", () => {
          animation.timeScale(2).reverse();
        });
      }
    });
  });
</script>

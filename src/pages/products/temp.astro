---
export function getStaticPaths() {
  return [
    { params: { slug: "proforce-phantom", id: "1", name: "Proforce Phantom" } },
  ];
}
import MapImage from "@/assets/img/home/map.svg";

import { getImage } from "astro:assets";

import MainLayout from "@/layouts/MainLayout.astro";

import HeroBg from "@/assets/img/phantom-bg.png";
import JetSvg from "@/assets/img/jet.svg";
import TempProductBg from "@/assets/img/temp-product-bg.png";
import MainButton from "@/components/buttons/MainButton.astro";

const optimizedBg = await getImage({
  src: HeroBg,
  format: "webp",
  width: 1366,
});

import IconResistance from "@/assets/img/icon-resistance.svg";
import IconProtection from "@/assets/img/icon-protection.svg";
import IconHydrophobic from "@/assets/img/icon-hydrophobic.svg";
import IconHealing from "@/assets/img/icon-healing.svg";

const product = {
  id: 1,
  title: "Proforce Phantom",
  thickness: "7 mil",
  warranty: "6 years",
  image: "/images/products/product-phantom-plus.png",
  features: [
    {
      id: 1,
      title: "IMPACT RESISTANCE",
      description: "Defends against rock chips, bug acids, and road debris.",
      icon: IconResistance,
    },
    {
      id: 2,
      title: "UV PROTECTION",
      description:
        "Prevents fading and yellowing from harsh sunlight exposure.",
      icon: IconProtection,
    },
    {
      id: 3,
      title: "HYDROPHOBIC",
      description:
        "Advanced top coat repels water and makes cleaning effortless.",
      icon: IconHydrophobic,
    },
    {
      id: 4,
      title: "SELF-HEALING",
      description:
        "Minor scratches and swirl marks vanish with heat application.",
      icon: IconHealing,
    },
  ],
};
---

<MainLayout title="Home" className="relative">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={optimizedBg.src}
      fetchpriority="high"
    />
  </Fragment>
  <section
    class={"bg-pf-navy hero-section-container sticky top-0 flex min-h-[85vh] flex-col items-start justify-center bg-cover bg-right px-8 py-5 md:px-12 lg:px-[clamp(1rem,6.2vw+1rem,100px)]"}
    style={`background-image: url('${optimizedBg.src}');`}
  >
    <div class="max-container flex w-full flex-col gap-12 md:gap-16">
      <h2
        class="font-pf-mera-pro flex flex-col text-[clamp(1rem,7vw,45px)] leading-10 tracking-[15%] text-white uppercase md:tracking-[18%] lg:leading-20"
      >
        <span class="animate-slide-up opacity-0"> Proforce </span>
        <span
          class="animate-slide-up text-transparent opacity-0 [-webkit-text-stroke:1.5px_white] lg:[-webkit-text-stroke:2px_white]"
        >
          Phantom
        </span>
      </h2>
      <h4
        class="font-pf-galano-grotesque text-[30px] tracking-[20%] text-white uppercase"
      >
        PFP7-60-50
      </h4>
    </div>
  </section>
  <section
    class="bg-pf-gohst-white relative z-1 px-8 pt-12 pb-6 text-center md:pt-20 md:pb-20"
  >
    <h3
      class="font-pf-mera-pro text-pf-navy-dark mx-auto mb-5 text-xs tracking-[25%] uppercase md:mb-12 md:text-sm"
    >
      Proforce Phantom
    </h3>
    <p
      class="font-pf-galano-grotesque text-pf-navy-dark mx-auto max-w-218.5 text-base leading-8 sm:text-2xl md:leading-11"
    >
      Designed for the daily driver who refuses to compromise on aesthetics.
      Proforce Phantom delivers an invisible, resilient shield against road
      debris, rock chips, and harsh elements, all while maintaining absolute
      clarity.
    </p>
    <!-- <div class="bg-pf-gohst-white absolute left-0 h-62.75 w-full"></div> -->
  </section>
  <section class="relative z-1 -m-1">
    <!-- <img style={`background-image: url('${WarrantyBg.src}');`} class="w-full" /> -->
    <!-- <WarrantyBg class="max-h-125.5 w-full" /> -->
    <div class="relative">
      <div class="absolute -bottom-px left-0 h-1/2 w-full bg-white"></div>
      <div class="bg-pf-gohst-white absolute -top-px left-0 h-1/2 w-full"></div>
      <div
        class="bg-pf-navy-dark relative flex max-h-125.5 w-full items-center justify-center py-20 [clip-path:polygon(0_0,100%_22%,100%_78%,0%_100%)] md:h-[65vh] md:py-0"
      >
        <JetSvg class="absolute top-0 left-0 h-full" />
        <h3
          class="font-pf-mera-pro relative flex flex-col items-center gap-1 text-4xl tracking-[12%] whitespace-break-spaces text-[#4D5A71] md:block md:text-[80px]"
        >
          <span
            class="font-pf-galano-grotesque relative font-extrabold text-white/5 uppercase md:text-[88px]"
            ><span
              class="absolute -left-0.5 w-full text-transparent [-webkit-text-stroke:2px_white]"
              >6 years</span
            >6 years</span
          >{" "}<span class="relative"
            ><span
              class="absolute -right-0.5 text-transparent opacity-50 [-webkit-text-stroke:1px_#4D5A71]"
              >Warranty</span
            >Warranty</span
          >
        </h3>
      </div>
    </div>

    <div class="relative z-1 bg-white px-8 md:px-25">
      <!-- <div class="relative z-1 -mt-10 px-25"> -->

      <div
        class="max-container relative flex flex-col items-end justify-between gap-4 py-8 md:flex-row md:py-25"
      >
        <div class="order-2 mt-4 text-center md:mt-0 md:text-left">
          <h6
            class="font-pf-mera-pro text-pf-navy mb-3 text-xs tracking-[25%] uppercase opacity-50 md:mb-5 md:text-sm"
          >
            The Technology
          </h6>
          <h5
            class="font-pf-galano-grotesque text-pf-navy mb-4 text-3xl font-bold uppercase md:mb-7 md:text-[50px]"
          >
            hyper-flex TECH
          </h5>
          <p
            class="font-pf-galano-grotesque text-pf-navy-dark mb-7 max-w-165.75 text-base leading-9 opacity-80 md:mb-13 md:text-xl"
          >
            Our proprietary hyper-flex technology ensures the film contours
            smoothly around the most aggressive curves without any risk of glue
            shifting or top-coat distortion.
          </p>
          <MainButton
            label="Download Specs"
            href=""
            className="text-pf-navy-dark border-pf-navy-dark hover:bg-pf-navy hover:border-pf-navy flex justify-center rounded-sm border bg-transparent px-5 py-3.5 text-sm font-semibold tracking-[1%] transition-colors duration-200 hover:text-white sm:w-4/5 md:max-w-62.5 md:px-4 md:py-4 md:text-base"
          />
        </div>
        <div
          class="relative right-0 order-1 h-auto w-full overflow-hidden rounded-xl bg-red-500 md:absolute md:order-3 md:h-154.5 md:w-86.75"
        >
          <img src={TempProductBg.src} class="h-full object-cover" />
        </div>
      </div>
    </div>
    <!-- Product Specs-->
    <div class="bg-pf-gohst-white">
      <div
        class="max-container active z-10 col-start-1 row-start-1 px-8 pt-12 pb-14 opacity-100 transition-opacity duration-500 md:px-25 md:pt-25 md:pb-20"
      >
        <h6
          class="mb-10 flex items-center justify-center gap-4 text-center text-xl font-bold tracking-[2%] uppercase md:mb-20 md:text-[60px]"
        >
          <span
            >{product.thickness}{" "}
            <span class="font-normal">Thickness</span></span
          >
        </h6>

        <div
          class="inset-0 mx-auto grid w-full max-w-292.75 grid-cols-1 items-center justify-items-center gap-8 md:grid-cols-[1fr_48.9%_1fr] md:gap-2"
        >
          <!-- Left Features (2 items) -->
          <div
            class="order-2 flex flex-col justify-between gap-8 text-left md:order-1 md:gap-4"
          >
            {
              product.features.slice(0, 2).map((feature) => (
                <div class="feature-item">
                  <feature.icon class="mb-3 ml-0.5 md:mb-5" />
                  <h3 class="slide-feature-title text-pf-navy font-pf-galano-grotesque mb-1 text-base font-bold md:text-lg">
                    {feature.title}
                  </h3>
                  <p class="slide-feature-desc text-pf-navy font-pf-galano-grotesque text-xs leading-5 tracking-normal opacity-70 md:text-[13px]">
                    {feature.description}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Center Image with Blur Transition -->
          {
            /* <div class="slide-image-wrapper flex flex-col items-center justify-center relative w-full order-1 md:order-2 "> */
          }
          <img
            src={product.image}
            alt={product.title}
            class={`slide-image order-1 md:order-2 object-contain aspect-520/242 max-w-[520px] transition-all duration-700 w-full ease-out ${0 === 0 ? "filter-none scale-100" : "blur-xl scale-110 object-center"}`}
          />

          {/* </div> */}

          <div
            class="order-2 flex flex-col justify-between gap-8 text-left md:order-1 md:gap-4"
          >
            {
              product.features.slice(2, 4).map((feature) => (
                <div class="feature-item">
                  <feature.icon class="mb-3 ml-0.5 md:mb-5" />
                  <h3 class="slide-feature-title text-pf-navy font-pf-galano-grotesque mb-1 text-base font-bold md:text-lg">
                    {feature.title}
                  </h3>
                  <p class="slide-feature-desc text-pf-navy font-pf-galano-grotesque text-xs leading-5 tracking-normal opacity-70 md:text-[13px]">
                    {feature.description}
                  </p>
                </div>
              ))
            }
          </div>
          <!-- Right Features (2 items) -->
          <!-- <div class="order-3 flex flex-col justify-between gap-4 text-left">
            {
              product.features.slice(2, 4).map((feature) => (
                <div class="feature-item">
                  <feature.icon class="mb-5 ml-0.5" />

                  <h3 class="slide-feature-title text-pf-navy font-pf-galano-grotesque mb-1 text-base font-bold md:text-lg">
                    {feature.title}
                  </h3>
                  <p class="slide-feature-desc text-pf-navy font-pf-galano-grotesque text-xs leading-5 tracking-normal opacity-70 md:text-[13px]">
                    {feature.description}
                  </p>
                </div>
              ))
            }
          </div> -->
        </div>
      </div>
    </div>
    <!-- Map -->
    <div class="bg-pf-gohst-white -mt-0.5 px-4 pb-20 md:px-12.5">
      <div
        class="max-container bg-linear-to-r from-[#21314D] to-[#0D1833] p-4.5 md:p-11.25"
      >
        <div
          class="flex flex-col justify-between border border-white/40 p-8 md:flex-row md:p-3.5"
        >
          <div
            class="font-pf-galano-grotesque flex flex-col justify-end pb-7 pl-0 text-center md:pl-12 md:text-left"
          >
            <h5
              class="mb-4 text-lg font-bold tracking-[5%] text-white uppercase md:text-[28px]"
            >
              Ready to Protect your Vehicle?
            </h5>
            <p
              class="mb-8 max-w-136.75 text-[15px] leading-6.75 font-normal text-white/80"
            >
              Flawless film requires flawless application. Connect with a
              certified Proforce installer today for a custom quote.
            </p>
            <MainButton
              label="View Nearby Installers"
              href=""
              className="text-pf-navy flex max-w-75 justify-center border-white bg-white px-6 py-4.5 text-xs font-semibold tracking-[1%] transition-colors duration-200 hover:bg-transparent hover:text-white md:px-11 md:py-4.5 md:text-sm"
            />
          </div>
          <div class="flex-1">
            <img
              src={MapImage.src}
              class="ml-auto max-h-70.75 object-contain"
              alt="Proforce Installer Locations Map - Worldwide"
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
<script>
  const header = document.querySelector(".main-header") as HTMLElement | null;
  const heroSectionCotnainer = document.querySelector(
    ".hero-section-container",
  ) as HTMLElement | null;

  if (header && heroSectionCotnainer) {
    heroSectionCotnainer.style.paddingTop =
      header.getBoundingClientRect().height + "px";
  }
</script>

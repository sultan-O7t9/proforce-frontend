const { product } = Astro.props;

const optimizedBg = await getImage({
  src: product.background,
  format: "webp",
  width: 1366,
});

// Split product title into main name and subtitle/variant for the hero layout
const titleParts = product.title.split(" ");
const brandName = titleParts[0];
const subName = titleParts.slice(1).join(" ");
---

<MainLayout title={product.title} className="relative">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={optimizedBg.src}
      fetchpriority="high"
    />
  </Fragment>
  <section
    class={twMerge(
      "bg-pf-navy hero-section-container sticky top-0 flex h-[73vh] md:min-h-[85vh] flex-col items-start justify-end md:justify-center bg-cover bg-right px-8 py-5 md:px-12 lg:px-[clamp(1rem,6.2vw+1rem,100px)]",
      subName.toLowerCase() === "apex" ? "bg-center md:bg-right" : "",
    )}
    style={`background-image: url('${optimizedBg.src}');`}
  >
    <div
      class="max-container flex w-full flex-col gap-4 pb-16 md:gap-16 md:pb-0"
    >
      <h2
        class="font-pf-mera-pro flex flex-col text-[clamp(1rem,7vw,45px)] leading-14 tracking-[15%] text-white uppercase md:tracking-[18%] lg:leading-20"
      >
        <span class="animate-slide-up opacity-0">
          {
            brandName
              .split("")
              .map((char) => (
                <span class="char inline-block opacity-0">
                  {char === " " ? "\u00A0" : char}
                </span>
              ))
          }
        </span>
        <span
          class={twMerge(
            "animate-slide-up text-transparent opacity-0 [-webkit-text-stroke:1.5px_white] lg:[-webkit-text-stroke:2px_white]",
            subName.toLowerCase() === "apex"
              ? "[-webkit-text-stroke:1.5px_#FDD637] lg:[-webkit-text-stroke:2px_#FDD637]"
              : "",

---
import MapImage from "@/assets/img/home/map.svg";
import MainButton from "@/components/buttons/MainButton.astro";
---

<section class="bg-pf-navy-gradient relative z-1 -m-2">
  <div
    class="max-container flex h-full flex-col items-center justify-center gap-6 py-16"
  >
    <h4
      class="font-pf-mera-pro mb-7 px-8 text-center text-xs leading-6 tracking-[25%] text-white md:text-sm"
    >
      CERTIFIED INSTALLATION
    </h4>
    <div class="relative w-full max-w-261.25 px-4 md:px-40">
      <img
        src={MapImage.src}
        alt="Proforce Installer Locations Map - Worldwide"
      />
      <div
        class="bg-pf-navy-dark-transparent absolute top-6 right-7 z-1 flex aspect-15/13 w-24 flex-col items-center justify-center rounded-2xl border border-[rgba(255,255,255,0.3)] pb-2 md:top-12.75 md:right-16 md:w-37.5 md:pb-4"
      >
        <h5
          class="font-pf-galano-grotesque text-pf-yellow text-3xl font-bold tracking-[6px] md:text-[45px]"
        >
          12
        </h5>
        <h6
          class="font-pf-galano-grotesque text-[10px] font-semibold tracking-[8%] text-white uppercase md:text-xs"
        >
          Countries
        </h6>
      </div>
      <div
        class="bg-pf-navy-dark-transparent absolute bottom-5 left-8 z-1 flex aspect-15/13 w-24 flex-col items-center justify-center rounded-2xl border border-[rgba(255,255,255,0.3)] pb-2 md:bottom-26 md:left-33.75 md:w-37.5 md:pb-4"
      >
        <h5
          class="font-pf-galano-grotesque text-pf-yellow text-3xl font-bold tracking-[2px] md:text-[45px] md:tracking-[6px]"
        >
          60+
        </h5>
        <h6
          class="font-pf-galano-grotesque text-[10px] font-semibold tracking-[8%] text-white uppercase md:text-xs"
        >
          Installers
        </h6>
      </div>
    </div>
    <div>
      <MainButton
        label="Find your nearest Installer"
        showAero
        href=""
        className="text-pf-yellow border-pf-yellow mx-auto"
        aeroClass="fill-pf-yellow"
      />
    </div>
  </div>
</section>

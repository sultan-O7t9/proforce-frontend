---
import MainButton from "@/components/buttons/MainButton.astro";
import Input from "@/components/forms/Input.astro";
import DealerLayout from "@/layouts/DealerLayout.astro";
import { ROUTES } from "@/lib/site";


---

<DealerLayout title="Dealer Portal Login">
    <form class="flex flex-col items-center gap-4.5 font-pf-galano-grotesque w-[clamp(280px,100%,480px)]">
            <!-- Email Field -->
             <Input name="email" placeholder={"Your Email"} id="email" type={"email"} label="Email" />
             <!-- Password Field -->
             <Input name="password" placeholder={"Your Password"} id="password" type={"password"} label="Password" />
             <Input name="password" placeholder={"Your Password"} id="password" type={"password"} label="Password" />


            <!-- Forgot Password Link -->
            <div class="flex justify-end self-end">
                <a href={ROUTES.DEALER_FORGOT_PASSWORD.href} aria-label={ROUTES.DEALER_FORGOT_PASSWORD.name} class="text-xs sm:text-sm font-medium text-pf-navy hover:text-pf-yellow transition-colors">
                    Forgot Password?
                </a>
            </div>

            <!-- Submit Button (Bonus for completeness) -->
               <MainButton label="Login" href="" className="text-xs md:text-sm py-3.5 md:py-4 px-5 md:px-14 sm:w-4/5 min-w-3xs flex justify-center font-semibold tracking-[1%] bg-pf-navy transition-colors duration-200 hover:bg-transparent hover:text-pf-navy border-pf-navy"/>


        </form>
</DealerLayout>
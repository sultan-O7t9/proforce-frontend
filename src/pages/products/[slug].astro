        >
          <!-- Left Features (2 items) -->
          <div
            class="order-2 mb-7 flex flex-col justify-between gap-13 text-left md:order-1 md:mb-0 md:gap-4"
          >
            {
              product.features.slice(0, 2).map((feature) => (
                <div class="feature-item md:max-w-auto mx-auto flex max-w-72 flex-col items-center text-center md:mx-0 md:items-start md:text-left">
                  <feature.icon class="mb-5 ml-0.5" />
                  <h3 class="slide-feature-title text-pf-navy font-pf-galano-grotesque mb-1 text-lg font-bold">
                    {feature.title}
                  </h3>
                  <p class="slide-feature-desc text-pf-navy font-pf-galano-grotesque text-[13px] leading-5 tracking-normal opacity-70">
                    {feature.description}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Center Image with Blur Transition -->
          <img
            src={product.image}
            alt={product.title}
            class="slide-image order-1 aspect-520/242 w-full max-w-130 scale-110 object-contain blur-xl transition-all duration-700 ease-out will-change-[transform,filter] md:order-2 md:w-auto"

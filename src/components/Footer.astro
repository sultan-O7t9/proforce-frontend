---
import FooterWatermark from "@/assets/img/footer-watermark.svg"
import IconFacebook from './icons/IconFacebook.astro';
import IconInstagram from "./icons/IconInstagram.astro";
import IconYoutube from "./icons/IconYoutube.astro";
import IconTiktok from "./icons/IconTiktok.astro";

const footerLinks=[
  {id:1,label:"One Film USA",href:""},
  {id:2,label:"Privacy Policy",href:""},
  {id:3,label:"Terms & Conditions",href:""},

]

const socialLinks=[
  {id:1,label:"Facebook",icon:IconFacebook,href:""},
  {id:1,label:"Instagram",icon:IconInstagram,href:""},
  {id:1,label:"Youtube",icon:IconYoutube,href:""},
  {id:1,label:"Tiktok",icon:IconTiktok,href:""},
]
---

<footer class="bg-pf-navy-dark w-full flex flex-col relative">
  <img class="h-autp w-full object-cover self-center absolute bottom-0" src={FooterWatermark.src}/>
  <div class="max-container flex w-full items-center justify-between text-white pt-10 pb-8 px-10 md:px-12 lg:px-[clamp(1rem,6.2vw+1rem,100px)] relative z-1">
    <nav>
      <ul class="flex flex-col gap-4 items-start">
        {
          footerLinks.map(link=>
            <li class="text-pf-white-80 tracking-[1%] uppercase text-sm  font-pf-galano-grotesque whitespace-nowrap after:content-[''] after:block after:w-full after:h-0.5 after:bg-pf-yellow after:scale-x-0 after:origin-right after:transition-transform after:duration-300 after:rounded-lg hover:after:origin-left hover:after:scale-x-100 transition-colors duration-300 hover:text-pf-yellow">
              <a href={link.href} >{link.label}</a>
            </li>
          )
        }
      </ul>
    </nav>
    <a href="/" aria-label="Proforce Logo">
      <img src="/images/icons/footer-logo.svg" class="cursor-pointer max-h-38.5 w-auto object-cover transition-all duration-300 hover:scale-95" />
    </a>
      <nav>
      <ul class="flex flex-row gap-4">
        {
          socialLinks.map(link=>
            <li class="text-pf-white-80 tracking-[1%] uppercase text-sm  font-pf-galano-grotesque cursor-pointer ">
              <a href={link.href} aria-label={link.label} target="_blank" class="h-11.5 w-11.5 flex justify-center items-center rounded-full bg-[rgba(255,255,255,0.05)] border border-[rgba(255,255,255,0.1)]transition-colors duration-300 hover:border-pf-yellow group">
                <link.icon/>
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
  <div class="p-0 m-0 h-[0.6px] w-full bg-white opacity-40" />
  <div class="max-container flex  items-center justify-between text-white py-8 relative z-1">
    <h6 class="font-pf-galano-grotesque tracking-[2%] text-pf-white-80 text-base">© {new Date().getFullYear()} <a href="/" class="transition-colors duration-300 hover:text-pf-yellow cursor-pointer">Proforce.</a> All Rights Reserved.</h6>
  </div>
</footer>

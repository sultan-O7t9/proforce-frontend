    },
    {
      name: "Reflection Detailing",
      location: "Karachi, Pakistan",
      phone: "+92 300 1234567",
      address: "Plot# 33-34, Sector 16, Main Korangi Rd...",
    },
    {
      name: "CarProofing Detailing",
      location: "Karachi, Pakistan",
      phone: "+92 300 1234567",
      address: "51-C 15th Commercial St, D.H.A Phase II...",
    },
  ],
  united_states: [
    {
      name: "GLOSSWORKS DETAIL LAB",
      location: "Denver, USA",
      phone: "+1 123 4567890",
      address: "789 Elm Avenue, Suite 12, Boulder, CO",
    },
    {
      name: "PRISTINE RIDE STUDIO",
      location: "Seattle, USA",
      phone: "+1 123 4567890",
      address: "456 Oak Drive, Floor 3, Austin, TX 78701",

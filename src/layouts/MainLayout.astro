---
/**
 * The single base layout every page wraps itself in. Two things worth
 * noting for a "best practice" starter:
 *
 * 1. `import '../styles/global.css'` happens exactly ONCE, here. Every
 *    page imports Layout.astro instead of the CSS file directly, so
 *    there's one canonical place Tailwind gets wired into the project.
 * 2. Header and Footer are rendered here rather than in every page —
 *    each page only has to provide its own unique content via <slot />.
 */
import {twMerge} from 'tailwind-merge';
import { Font } from 'astro:assets';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/lib/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  className?: string;
}

const { title, description = SITE.description, } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

<Font cssVariable="--font-mera-pro" preload />
<Font cssVariable="--font-galano-grotesque" preload />

    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900 font-pf-galano-grotesque">
    <Header />
    <main class={twMerge("flex-1", Astro.props.className)}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

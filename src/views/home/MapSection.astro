---
import MapImage from "@/assets/img/home/map.svg";
import MainButton from "@/components/buttons/MainButton.svelte";
import { ROUTES } from "@/lib/site";
---

<section id="stats-section" class="bg-pf-navy-gradient relative z-1 -m-2">
  <div
    class="max-container flex h-full flex-col items-center justify-center gap-6 py-16"
  >
    <h4
      class="font-pf-mera-pro map-heading mb-7 px-8 text-center text-xs leading-6 tracking-[25%] text-white md:text-sm"
    >
      CERTIFIED INSTALLATION
    </h4>
    <div class="map-img-container relative w-full max-w-261.25 px-4 md:px-40">
      <img
        src={MapImage.src}
        alt="Proforce Installer Locations Map - Worldwide"
      />
      <div
        class="stat-box-countries bg-pf-navy-dark-transparent absolute top-6 right-7 z-1 flex aspect-15/13 w-24 flex-col items-center justify-center rounded-2xl border border-[rgba(255,255,255,0.3)] pb-2 md:top-12.75 md:right-16 md:w-37.5 md:pb-4"
      >
        <h5
          id="countries-count"
          class="font-pf-causten text-pf-yellow text-3xl font-extrabold tracking-[6px] md:text-[45px]"
        >
          0
        </h5>
        <h6
          class="font-pf-galano-grotesque text-[10px] font-semibold tracking-[8%] text-white uppercase md:text-xs"
        >
          Countries
        </h6>
      </div>
      <div
        class="stat-box-installers bg-pf-navy-dark-transparent absolute bottom-5 left-8 z-1 flex aspect-15/13 w-24 flex-col items-center justify-center rounded-2xl border border-[rgba(255,255,255,0.3)] pb-2 md:bottom-26 md:left-33.75 md:w-37.5 md:pb-4"
      >
        <h5
          id="installers-count"
          class="font-pf-causten text-pf-yellow text-3xl font-extrabold tracking-[2px] md:text-[45px] md:tracking-[6px]"
        >
          0+
        </h5>
        <h6
          class="font-pf-galano-grotesque text-[10px] font-semibold tracking-[8%] text-white uppercase md:text-xs"
        >
          Installers
        </h6>
      </div>
      <div
        class="stat-box-applications bg-pf-navy-dark-transparent absolute bottom-5 left-8 z-1 flex aspect-15/13 w-24 flex-col items-center justify-center rounded-2xl border border-[rgba(255,255,255,0.3)] pb-2 md:bottom-10 md:left-142 md:w-37.5 md:pb-4"
      >
        <h5
          id="installers-count"
          class="font-pf-causten text-pf-yellow text-3xl font-extrabold tracking-[2px] md:text-[45px] md:tracking-[6px]"
        >
          5k+
        </h5>
        <h6
          class="font-pf-galano-grotesque text-[10px] font-semibold tracking-[8%] text-white uppercase md:text-xs"
        >
          Applications
        </h6>
      </div>
    </div>
    <div>
      <MainButton
        client:load
        label="Find your nearest Installer"
        showAero
        href={ROUTES.INSTALLERS.href}
        className="text-pf-yellow border-pf-yellow mx-auto"
        aeroClass="fill-pf-yellow"
      />
    </div>
  </div>
</section>

<style>
  @keyframes floatUpAndDown {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .floating {
    animation: floatUpAndDown 3.5s ease-in-out infinite;
  }

  .floating-delayed {
    animation: floatUpAndDown 4s ease-in-out infinite;
    animation-delay: 0.5s;
  }
</style>

<script>
  import { gsap, setupWordScrollAnimation } from "@/lib/gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context;
  setupWordScrollAnimation(".map-heading");

  function initStatsAnimation() {
    ctx = gsap.context(() => {
      const mapContainer = document.querySelector(".map-img-container");
      const countriesBox = document.querySelector(".stat-box-countries");
      const installersBox = document.querySelector(".stat-box-installers");
      const applicationsBox = document.querySelector(".stat-box-applications");
      const countriesEl = document.querySelector("#countries-count");
      const installersEl = document.querySelector("#installers-count");

      if (
        !mapContainer ||
        !countriesBox ||
        !installersBox ||
        !applicationsBox ||
        !countriesEl ||
        !installersEl
      )
        return;

      const statsObj = { countries: 0, installers: 0 };
      let lastCountries = -1;
      let lastInstallers = -1;

      // 1. Slide-up and Count-Up Timeline Triggered by .map-img-container
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: mapContainer,
          start: "top 85%",
          once: true,
        },
      });

      // Slide up and fade in the count boxes
      tl.fromTo(
        [countriesBox, installersBox, applicationsBox],
        { y: 50, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 1,
          stagger: 0.2,
          ease: "power2.out",
          onComplete: () => {
            // 2. Programmatically assign CSS floating animation classes after slide-up finishes
            countriesBox.classList.add("floating");
            applicationsBox.classList.add("floating-delayed");
            installersBox.classList.add("floating");
          },
        },
        0,
      );

      // Count up numbers simultaneously
      tl.to(
        statsObj,
        {
          countries: 12,
          installers: 60,
          duration: 1.5,
          ease: "power1.out",
          onUpdate: () => {
            const c = statsObj.countries | 0;
            const i = statsObj.installers | 0;

            if (c !== lastCountries) {
              countriesEl.textContent = c.toString();
              lastCountries = c;
            }
            if (i !== lastInstallers) {
              installersEl.textContent = i + "+";
              lastInstallers = i;
            }
          },
        },
        0,
      );
    });
  }

  initStatsAnimation();

  document.addEventListener("astro:before-swap", () => {
    if (ctx) ctx.revert();
  });

  document.addEventListener("astro:after-swap", initStatsAnimation);
</script>

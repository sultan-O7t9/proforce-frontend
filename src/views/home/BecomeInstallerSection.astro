---
import MainButton from "@/components/buttons/MainButton.astro";
---

<section class="benefits-section bg-pf-white-v2 relative z-1 -m-2">
<div class="max-container h-full p-20">
      <div class="border border-pf-navy p-12 flex flex-col items-center justify-center gap-16.5">

            <h4 class="font-pf-mera-pro text-pf-navy text-sm tracking-[25%] text-center">THE PROFORCE DEALER PORTAL</h4>
            <h6 class="font-pf-galano-grotesque text-pf-navy text-5xl leading-16 text-center uppercase font-bold max-w-223.5">ALIGN YOUR BUSINESS WITH THE ULTIMATE PROTECTIVE FORCE</h6>
            <MainButton label="Become an Installer" href="" className="py-5 px-14 font-semibold tracking-[1%] bg-pf-navy transition-colors duration-200 hover:bg-pf-light-navy hover:text-pf-navy border-pf-navy"/>
      </div>
</div>
</section>

---
import MainButton from "@/components/buttons/MainButton.svelte";
import { ROUTES } from "@/lib/site";
import { twMerge } from "tailwind-merge";

interface Props {
  bgUrl: string;
  className?: string;
}

const line1 = "PRISTINE.";
const line2 = "INVISIBLE.";
const line3 = "INVINCIBLE.";

const { bgUrl, className } = Astro.props;
---

<section
  class={twMerge(
    "bg-pf-navy hero-section-container sticky top-0 flex h-screen flex-col items-start justify-center bg-cover bg-right px-8 py-5 md:px-12 md:py-8.75 lg:px-[clamp(1rem,6.2vw+1rem,100px)]",
    className,
  )}
>
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute top-1/2 left-1/2 -z-20 h-auto min-h-full w-auto min-w-full -translate-x-1/2 -translate-y-1/2 object-cover"
  >
    <source src="/vids/proforce_intro_home.webm" type="video/webm" />
    <source src="/vids/proforce_intro_home.mp4" type="video/mp4" />
    Your browser does not support HTML5 video.
  </video>
  <div class="absolute inset-0 -z-10 bg-black/50"></div>
  <!-- style={`background-image: url('${bgUrl}');`} -->

  <div
    class="max-container relative z-10 flex w-full flex-col gap-16 md:gap-20"
  >
    <h2
      class="font-pf-mera-pro mt-24 flex flex-col gap-5 text-[clamp(1rem,7vw,45px)] leading-10 tracking-[15%] text-white sm:mt-auto md:tracking-[18%] lg:leading-20"
    >
      <span class="animate-slide-u headline-text"
        >{
          line1
            .split("")
            .map((char) => (
              <span class="char inline-block opacity-0">
                {char === " " ? "\u00A0" : char}
              </span>
            ))
        }</span
      >
      <span class="animate-slide-u headline-text"
        >{
          line2
            .split("")
            .map((char) => (
              <span class="char inline-block opacity-0">
                {char === " " ? "\u00A0" : char}
              </span>
            ))
        }</span
      >
      <span
        class="animate-slide-u headline-text text-transparent [-webkit-text-stroke:1.5px_white] lg:[-webkit-text-stroke:2px_white]"
        >{
          line3
            .split("")
            .map((char) => (
              <span class="char inline-block opacity-0">
                {char === " " ? "\u00A0" : char}
              </span>
            ))
        }</span
      >
    </h2>
    <div
      class="animate-slide-up slide-up-delay flex flex-col justify-start gap-4 self-start opacity-0"
    >
      <MainButton
        className="gap-1.75 px-5.25 py-3.5 text-xs sm:text-xs"
        client:load
        label="Explore Products"
        showAero
        href="#products-section"
        aeroClass="h-2.5 sm:h-auto"
      />
      <MainButton
        className="text-pf-yellow border-pf-yellow justify-center gap-1.75 px-5.25 py-3.5 text-xs sm:text-xs md:hidden"
        client:load
        label="Find an Installer"
        href={ROUTES.INSTALLERS.href}
      />
    </div>
  </div>
</section>


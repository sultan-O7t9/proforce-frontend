---
import MapImage from "@/assets/img/home/map.svg";
import { getImage } from "astro:assets";
import MainLayout from "@/layouts/MainLayout.astro";
import PhantomBg from "@/assets/img/phantom-bg.png";
import PhantomPlusBg from "@/assets/img/phantom-plus-bg.png";
import ApexBg from "@/assets/img/apex-bg.png";
import JetSvg from "@/assets/img/jet.svg";
import TempProductBg from "@/assets/img/temp-product-bg.png";
import MainButton from "@/components/buttons/MainButton.svelte";

import IconResistance from "@/assets/img/icon-resistance.svg";
import IconProtection from "@/assets/img/icon-protection.svg";
import IconHydrophobic from "@/assets/img/icon-hydrophobic.svg";
import IconHealing from "@/assets/img/icon-healing.svg";
import { ROUTES } from "@/lib/site";

export function getStaticPaths() {
  const products = [
    {
      id: 1,
      background: PhantomBg,
      title: "Proforce Phantom",
      slug: "proforce-phantom",
      thickness: "7 mil",
      warranty: "6 years",
      technology: {
        heading: "hyper-flex TECH",
        description:
          "Our proprietary hyper-flex technology ensures the film contours smoothly around the most aggressive curves without any risk of glue shifting or top-coat distortion.",
      },
      image: "/images/products/product-phantom-plus.png",
      sku: "PFP7-60-50",
      description:
        "Designed for the daily driver who refuses to compromise on aesthetics. Proforce Phantom delivers an invisible, resilient shield against road debris, rock chips, and harsh elements, all while maintaining absolute clarity.",
      features: [
        {
          id: 1,
          title: "IMPACT RESISTANCE",
          description:
            "Defends against rock chips, bug acids, and road debris.",
          icon: IconResistance,
        },
        {
          id: 2,
          title: "UV PROTECTION",
          description:
            "Prevents fading and yellowing from harsh sunlight exposure.",
          icon: IconProtection,
        },
        {
          id: 3,
          title: "HYDROPHOBIC",
          description:
            "Advanced top coat repels water and makes cleaning effortless.",
          icon: IconHydrophobic,
        },
        {
          id: 4,
          title: "SELF-HEALING",
          description:
            "Minor scratches and swirl marks vanish with heat application.",
          icon: IconHealing,
        },
      ],
    },
    {
      id: 2,
      background: PhantomPlusBg,
      title: "Proforce Phantom+",
      slug: "proforce-phantom-plus",
      thickness: "8 mil",
      warranty: "6 years",
      technology: {
        heading: "hyper-flex TECH",
        description:
          "Our proprietary hyper-flex technology ensures the film contours smoothly around the most aggressive curves without any risk of glue shifting or top-coat distortion.",
      },
      image: "/images/products/product-phantom-plus.png",
      sku: "PFP8-60-50",
      description:
        "For environments demanding a heavier shield. Proforce Phantom+ utilizes a thicker 8-mil construction for superior impact resistance, ensuring maximum protection without losing effortless workability.",
      features: [
        {
          id: 1,
          title: "UPGRADED IMPACT SHIELD",
          description:
            "Thicker 8-mil barrier stops severe rock chips and aggressive road debris.",
          icon: IconResistance,
        },
        {
          id: 2,
          title: "ADVANCED UV BARRIER",
          description:
            "Fortified shield prevents fading and yellowing from intense solar exposure.",
          icon: IconProtection,
        },
        {
          id: 3,
          title: "ENHANCED HYDROPHOBICS",
          description:
            "Upgraded top coat actively repels water, making daily washing effortless.",
          icon: IconHydrophobic,
        },
        {
          id: 4,
          title: "ACTIVE SELF-HEALING",
          description:
            "Scratches and swirl marks vanish rapidly with standard heat application.",
          icon: IconHealing,
        },
      ],
    },
    {
      id: 3,
      background: ApexBg,
      title: "Proforce Apex",
      productColor: "primary",
      slug: "proforce-apex",
      thickness: "8 mil",
      warranty: "10 years",
      image: "/images/products/product-apex.png",
      sku: "PFA8-60-50",
      technology: {
        heading: "EVOCOAT TECHNOLOGY™",
        description:
          "Unleash brilliance with our Evocoat-enhanced PPF. This proprietary nano-ceramic topcoat boosts gloss to a dazzling, mirror-like finish while defending against UV damage.",
      },
      description:
        "Meet our flagship film. Engineered for the perfectionist, Proforce Apex combines elite durability with unmatched optical clarity and deep gloss. It doesn't just protect your vehicle—it elevates it, delivering a flawless, show-car finish.",
      features: [
        {
          id: 1,
          title: "ELITE IMPACT ARMOR",
          description:
            "Maximum 8-mil protection against severe impacts, bug acids, and harsh hazards.",
          icon: IconResistance,
        },
        {
          id: 2,
          title: "ULTIMATE GLOSS",
          description:
            "Enhances your factory paint with a dazzling, flawless mirror-like finish.",
          icon: IconProtection,
        },
        {
          id: 3,
          title: "EVOCOAT™ SELF-CLEANING",
          description:
            "Extreme hydrophobic technology which instantly repels water, dirt, and chemical contaminants.",
          icon: IconHydrophobic,
        },
        {
          id: 4,
          title: "RAPID SELF-HEALING",
          description:
            "Advanced polymer structure erases surface scratches instantly with minimal active heat.",
          icon: IconHealing,
        },
      ],
    },
  ];

  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const optimizedBg = await getImage({
  src: product.background,
  format: "webp",
  width: 1366,
});

// Split product title into main name and subtitle/variant for the hero layout
const titleParts = product.title.split(" ");
const brandName = titleParts[0];
const subName = titleParts.slice(1).join(" ");
---

<MainLayout title={product.title} className="relative">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={optimizedBg.src}
      fetchpriority="high"
    />
  </Fragment>
  <section
    class={"bg-pf-navy hero-section-container sticky top-0 flex min-h-[85vh] flex-col items-start justify-center bg-cover bg-right px-8 py-5 md:px-12 lg:px-[clamp(1rem,6.2vw+1rem,100px)]"}
    style={`background-image: url('${optimizedBg.src}');`}
  >
    <div class="max-container flex w-full flex-col gap-12 md:gap-16">
      <h2
        class="font-pf-mera-pro flex flex-col text-[clamp(1rem,7vw,45px)] leading-10 tracking-[15%] text-white uppercase md:tracking-[18%] lg:leading-20"
      >
        <span class="animate-slide-up opacity-0">
          {
            brandName
              .split("")
              .map((char) => (
                <span class="char inline-block opacity-0">
                  {char === " " ? "\u00A0" : char}
                </span>
              ))
          }
        </span>
        <span
          class="animate-slide-up text-transparent opacity-0 [-webkit-text-stroke:1.5px_white] lg:[-webkit-text-stroke:2px_white]"
        >
          {
            subName
              .split("")
              .map((char) => (
                <span class="char inline-block opacity-0">
                  {char === " " ? "\u00A0" : char}
                </span>
              ))
          }
        </span>
      </h2>
      <h4
        class="font-pf-galano-grotesque text-[30px] tracking-[20%] text-white uppercase"
      >
        {
          product.sku
            .split("")
            .map((char) => (
              <span class="char inline-block opacity-0">
                {char === " " ? "\u00A0" : char}
              </span>
            ))
        }
      </h4>
    </div>
  </section>
  <section
    class="bg-pf-gohst-white relative z-1 px-8 pt-12 pb-6 text-center md:pt-20 md:pb-20"
  >
    <h3
      class="font-pf-mera-pro text-pf-navy-dark product-title-heading mx-auto mb-5 text-xs tracking-[25%] uppercase md:mb-12 md:text-sm"
    >
      {product.title}
    </h3>
    <p
      class="font-pf-galano-grotesque text-pf-navy-dark product-descripton mx-auto max-w-218.5 text-base leading-8 sm:text-2xl md:leading-9"
    >
      {product.description}
    </p>
  </section>
  <section class="relative z-1 -m-1">
    <div class="relative">
      <div class="absolute -bottom-px left-0 h-1/2 w-full bg-white"></div>
      <div class="bg-pf-gohst-white absolute -top-px left-0 h-1/2 w-full"></div>
      <div
        class="bg-pf-navy-dark relative flex max-h-125.5 w-full items-center justify-center py-20 [clip-path:polygon(0_0,100%_22%,100%_78%,0%_100%)] md:h-[65vh] md:py-0"
      >
        <JetSvg class="absolute top-0 left-0 h-full" />
        <h3
          class="font-pf-mera-pro relative flex flex-col items-center gap-1 text-center text-4xl tracking-[12%] whitespace-break-spaces text-[#4D5A71] md:block md:text-[80px]"
        >
          <span
            class="font-pf-galano-grotesque relative font-extrabold text-white/5 uppercase md:text-[88px]"
            ><span
              class="absolute -left-0.5 w-full text-transparent [-webkit-text-stroke:2px_white]"
              >{product.warranty}</span
            >{product.warranty}</span
          >{" "}<span class="relative"
            ><span
              class="absolute -right-0.5 text-transparent opacity-50 [-webkit-text-stroke:1px_#4D5A71]"
              >Warranty</span
            >Warranty</span
          >
        </h3>
      </div>
    </div>

    <div class="relative z-1 bg-white px-8 md:px-25">
      <div
        class="max-container relative flex flex-col items-end justify-between gap-4 py-8 md:flex-row lg:py-25"
      >
        <div class="order-2 mt-4 text-center md:mt-0 md:text-left">
          <h6
            class="font-pf-mera-pro text-pf-navy tech-heading mb-3 text-xs tracking-[25%] uppercase opacity-50 md:mb-5 md:text-sm"
          >
            The Technology
          </h6>
          <h5
            class="font-pf-galano-grotesque text-pf-navy tech-name mb-4 text-3xl font-bold uppercase md:mb-7 md:text-[50px]"
          >
            {product.technology.heading}
          </h5>
          <p
            class="font-pf-galano-grotesque text-pf-navy-dark tech-description mb-7 max-w-165.75 text-base leading-7 opacity-80 md:mb-13 md:text-xl"
          >
            {product.technology.description}
          </p>
          <MainButton
            client:load
            label="Download Specs"
            href=""
            className="text-pf-navy-dark border-pf-navy-dark hover:bg-pf-navy hover:border-pf-navy mx-auto flex justify-center rounded-sm border bg-transparent px-5 py-3.5 text-sm font-semibold tracking-[1%] transition-colors duration-200 hover:text-white sm:w-4/5 md:mx-0 md:max-w-62.5 md:px-4 md:py-4 md:text-base"
          />
        </div>
        <div
          class="tech-banner product-features-section relative right-0 bottom-[5vh] order-1 h-auto w-full overflow-hidden rounded-xl bg-red-500 md:order-3 md:h-154.5 md:w-86.75 lg:absolute"
        >
          <img
            src={TempProductBg.src}
            class="h-full w-full object-cover"
            alt="Technology background"
          />
        </div>
      </div>
    </div>
    <!-- Product Specs-->
    <div class="bg-pf-gohst-white">
      <div
        class="max-container active z-10 col-start-1 row-start-1 px-8 pt-12 pb-14 opacity-100 transition-opacity duration-500 md:px-25 md:pt-25 md:pb-20"
      >
        <h6
          class="mb-10 flex items-center justify-center gap-4 text-center text-xl font-bold tracking-[2%] uppercase md:mb-20 md:text-[60px]"
        >
          <span
            >{product.thickness}{" "}
            <span class="font-normal">Thickness</span></span
          >
        </h6>

        <div
          class="inset-0 mx-auto grid w-full max-w-292.75 grid-cols-1 items-center justify-items-center gap-8 md:grid-cols-[1fr_48.9%_1fr] md:gap-2"
        >
          <!-- Left Features (2 items) -->
          <div
            class="feature-column-left order-2 flex flex-col justify-between gap-8 text-left md:order-1 md:gap-4"
          >
            {
              product.features.slice(0, 2).map((feature) => (
                <div class="feature-item">
                  <feature.icon class="mb-3 ml-0.5 md:mb-5" />
                  <h3 class="slide-feature-title text-pf-navy font-pf-galano-grotesque mb-1 text-base font-bold md:text-lg">
                    {feature.title}
                  </h3>
                  <p class="slide-feature-desc text-pf-navy font-pf-galano-grotesque text-xs leading-5 tracking-normal opacity-70 md:text-[13px]">
                    {feature.description}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Center Image with Blur Transition -->
          <img
            src={product.image}
            alt={product.title}
            class="slide-image order-1 aspect-520/242 w-full max-w-[520px] scale-110 object-contain blur-xl transition-all duration-700 ease-out will-change-[transform,filter] md:order-2 md:w-auto"
          />

          <!-- Right Features (2 items) -->
          <div
            class="feature-column-right order-2 flex flex-col justify-between gap-8 text-left md:order-3 md:gap-4"
          >
            {
              product.features.slice(2, 4).map((feature) => (
                <div class="feature-item">
                  <feature.icon class="mb-3 ml-0.5 md:mb-5" />
                  <h3 class="slide-feature-title text-pf-navy font-pf-galano-grotesque mb-1 text-base font-bold md:text-lg">
                    {feature.title}
                  </h3>
                  <p class="slide-feature-desc text-pf-navy font-pf-galano-grotesque text-xs leading-5 tracking-normal opacity-70 md:text-[13px]">
                    {feature.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <!-- Map -->
    <div class="bg-pf-gohst-white -mt-0.5 px-4 pb-20 md:px-12.5">
      <div
        class="max-container bg-linear-to-r from-[#21314D] to-[#0D1833] p-4.5 md:p-11.25"
      >
        <div
          class="flex flex-col justify-between border border-white/40 p-8 md:flex-row md:p-3.5"
        >
          <div
            class="font-pf-galano-grotesque flex flex-col justify-end pb-7 pl-0 text-center md:pl-12 md:text-left"
          >
            <h5
              class="protect-heading mb-4 text-lg font-bold tracking-[5%] text-white uppercase md:text-[28px]"
            >
              Ready to Protect your Vehicle?
            </h5>
            <p
              class="mb-14 max-w-136.75 text-[15px] leading-6.75 font-normal text-white/80"
            >
              Flawless film requires flawless application. Connect with a
              certified Proforce installer today for a custom quote.
            </p>
            <MainButton
              client:load
              label="View Nearby Installers"
              href={ROUTES.INSTALLERS.href}
              className="text-pf-navy mx-auto flex max-w-75 justify-center border-white bg-white px-6 py-4.5 text-xs font-semibold tracking-[1%] transition-colors duration-200 hover:bg-transparent hover:text-white md:mx-0 md:py-4.5 md:text-sm lg:px-11"
            />
          </div>
          <div
            class="flex min-w-[50%] flex-1 justify-center md:justify-end lg:min-w-auto"
          >
            <img
              src={MapImage.src}
              class="max-h-70.75 object-contain"
              alt="Proforce Installer Locations Map - Worldwide"
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .slide-image {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform: translateZ(0);
  }
</style>

<script>
  import { gsap, setupWordScrollAnimation } from "@/lib/gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  setupWordScrollAnimation(".product-title-heading");
  setupWordScrollAnimation(".product-descripton", 0.05, 1);
  setupWordScrollAnimation(".tech-heading");
  setupWordScrollAnimation(".tech-name");
  setupWordScrollAnimation(".tech-description");
  setupWordScrollAnimation(".protect-heading");

  const chars = document.querySelectorAll(".char");

  gsap.fromTo(
    chars,
    { opacity: 0, y: 10 },
    {
      opacity: 1,
      y: 0,
      delay: 0.2,
      stagger: 0.025,
      duration: 0.75,
      ease: "power2.out",
    },
  );

  let ctx: gsap.Context;

  function initAnimations() {
    ctx = gsap.context(() => {
      // 1. Tech Banner Slide From Left
      const techBanner = document.querySelector(".tech-banner");
      if (techBanner) {
        gsap.from(techBanner, {
          scrollTrigger: {
            trigger: techBanner,
            start: "top 85%",
            once: true,
          },
          x: -50,
          opacity: 0,
          duration: 0.8,
          ease: "power2.out",
        });
      }

      // 2. Product Specs Features Slide From Left & Image Blur-to-Clear Animation
      const specsSection = document.querySelector(".slide-image");
      if (specsSection) {
        const leftFeatures = document.querySelectorAll(
          ".feature-column-left .feature-item",
        );
        const rightFeatures = document.querySelectorAll(
          ".feature-column-right .feature-item",
        );

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: specsSection,
            start: "top 80%",
            once: true,
          },
        });

        // Slide features in from left
        tl.fromTo(
          [leftFeatures, rightFeatures],
          { x: -50, opacity: 0 },
          {
            x: 0,
            opacity: 1,
            duration: 0.8,
            stagger: 0.12,
            ease: "power2.out",
          },
          0,
        );

        // Transition image from blur to clear
        tl.to(
          specsSection,
          {
            filter: "blur(0px)",
            scale: 1,
            duration: 0.8,
            ease: "power2.out",
          },
          0,
        );
      }
    });
  }

  initAnimations();

  const header = document.querySelector(".main-header") as HTMLElement | null;
  const heroSectionContainer = document.querySelector(
    ".hero-section-container",
  ) as HTMLElement | null;

  if (header && heroSectionContainer) {
    heroSectionContainer.style.paddingTop =
      header.getBoundingClientRect().height + "px";
  }

  document.addEventListener("astro:before-swap", () => {
    if (ctx) ctx.revert();
  });

  document.addEventListener("astro:after-swap", initAnimations);
</script>

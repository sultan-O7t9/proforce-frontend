---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

interface Props extends HTMLAttributes<"input"> {
  label?: string;
  labelClass?: string;
  containerClass?: string;
  inputClass?: string;
  id: string;
  name: string;
  placeholder?: string;
}

const {
  label,
  name,
  placeholder = "Upload File (Max 5MB)",
  labelClass = "",
  inputClass = "",
  containerClass = "",
  id,
  ...rest
} = Astro.props;
---

<div class={twMerge("w-full mb-1.5 file-picker-wrapper", containerClass)}>
  {
    label ? (
      <label
        for={id}
        class={twMerge(
          "text-pf-black mb-1.5 block text-sm font-semibold md:mb-3.5",
          labelClass,
        )}
      >
        {label}
      </label>
    ) : null
  }
  <div class="relative w-full">
    <!-- Input Container (Shown by default) -->
    <div class="file-input-container">
      <input
        type="file"
        id={id}
        name={name}
        class="file-input-element hidden"
        {...rest}
      />
      <label
        for={id}
        class={twMerge(
          "flex items-center justify-center gap-2 w-full px-5 py-3 md:py-4 rounded-sm border border-dashed border-pf-navy/30 text-pf-black bg-white text-sm cursor-pointer hover:border-pf-navy-dark focus:outline-none focus:ring-2 focus:ring-pf-navy-dark focus:border-pf-navy-dark transition-colors",
          inputClass,
        )}
      >
        <!-- Upload Icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="h-5 w-5 text-gray-500"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"
          ></path>
        </svg>
        <span class="text-gray-500">{placeholder}</span>
      </label>
    </div>

    <!-- Thumbnail / File Preview Container (Hidden by default) -->
    <div
      class="file-preview-container border-pf-navy/30 flex hidden w-full items-center justify-between rounded-sm border bg-white px-4 py-2.5"
    >
      <div class="flex items-center gap-3 overflow-hidden">
        <div
          class="flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded border border-gray-200 bg-gray-100"
        >
          <img
            src=""
            alt="Thumbnail"
            class="file-thumbnail hidden h-full w-full object-cover"
          />
          <!-- Generic Document Icon for non-images -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="file-generic-icon h-5 w-5 text-gray-400"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
            ></path>
          </svg>
        </div>
        <div class="flex flex-col truncate">
          <span class="file-name text-pf-black truncate text-sm font-medium"
          ></span>
          <span class="file-size text-xs text-gray-500"></span>
        </div>
      </div>
      <!-- Discard Button -->
      <button
        type="button"
        class="file-discard-btn hover:text-pf-black ml-2 flex-shrink-0 rounded-full p-1 text-gray-400 transition-colors hover:bg-gray-100 focus:outline-none"
        aria-label="Remove file"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="h-5 w-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  function setupFilePickers() {
    const wrappers = document.querySelectorAll(".file-picker-wrapper");

    wrappers.forEach((wrapper) => {
      const fileInput = wrapper.querySelector(
        ".file-input-element",
      ) as HTMLInputElement;
      const inputContainer = wrapper.querySelector(".file-input-container");
      const previewContainer = wrapper.querySelector(".file-preview-container");
      const thumbnailImg = wrapper.querySelector(
        ".file-thumbnail",
      ) as HTMLImageElement;
      const genericIcon = wrapper.querySelector(".file-generic-icon");
      const fileNameSpan = wrapper.querySelector(".file-name");
      const fileSizeSpan = wrapper.querySelector(".file-size");
      const discardBtn = wrapper.querySelector(".file-discard-btn");

      if (!fileInput || !inputContainer || !previewContainer || !discardBtn)
        return;

      // Handle file selection
      fileInput.addEventListener("change", () => {
        const files = fileInput.files;
        if (!files || files.length === 0) return;

        const file = files[0];

        // Populate file details
        if (fileNameSpan) fileNameSpan.textContent = file.name;
        if (fileSizeSpan) {
          const sizeKB = (file.size / 1024).toFixed(1);
          const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
          fileSizeSpan.textContent =
            file.size > 1024 * 1024 ? `${sizeMB} MB` : `${sizeKB} KB`;
        }

        // Generate image thumbnail if image type, else fallback icon
        if (file.type.startsWith("image/")) {
          const reader = new FileReader();
          reader.onload = (uploadEvent) => {
            if (thumbnailImg && uploadEvent.target?.result) {
              thumbnailImg.src = uploadEvent.target.result as string;
              thumbnailImg.classList.remove("hidden");
              if (genericIcon) genericIcon.classList.add("hidden");
            }
          };
          reader.readAsDataURL(file);
        } else {
          if (thumbnailImg) {
            thumbnailImg.src = "";
            thumbnailImg.classList.add("hidden");
          }
          if (genericIcon) genericIcon.classList.remove("hidden");
        }

        // Switch views
        inputContainer.classList.add("hidden");
        previewContainer.classList.remove("hidden");
      });

      // Handle file discard
      discardBtn.addEventListener("click", () => {
        fileInput.value = ""; // Clear native input value

        // Reset states
        if (thumbnailImg) {
          thumbnailImg.src = "";
          thumbnailImg.classList.add("hidden");
        }
        if (genericIcon) genericIcon.classList.remove("hidden");
        if (fileNameSpan) fileNameSpan.textContent = "";
        if (fileSizeSpan) fileSizeSpan.textContent = "";

        // Switch views back
        previewContainer.classList.add("hidden");
        inputContainer.classList.remove("hidden");
      });
    });
  }

  // Run on initial load
  setupFilePickers();

  // Support Astro page transitions if enabled
  document.addEventListener("astro:after-swap", setupFilePickers);
</script>

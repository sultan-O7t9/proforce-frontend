      </h2>
      <h4
        class="font-pf-galano-grotesque text-sm tracking-[20%] text-white uppercase sm:text-base md:text-[30px]"
      >
        {
          product.sku
            .split("")
            .map((char) => (
              <span class="char inline-block opacity-0">
                {char === " " ? "\u00A0" : char}

            {product.technology.heading}
          </h5>
          <p
            class="font-pf-galano-grotesque text-pf-navy-dark tech-description mb-6 max-w-165.75 text-sm leading-7 opacity-80 md:mb-13 md:text-xl"
          >
            {product.technology.description}
          </p>
          <MainButton
            client:load
            label="Download Specs"
            href=""
            className="text-pf-navy-dark border-pf-navy-dark hover:bg-pf-navy hover:border-pf-navy flex max-w-46 justify-center rounded-sm border bg-transparent px-4 py-3.25 text-xs font-semibold tracking-[1%] transition-colors duration-200 hover:text-white sm:w-4/5 md:max-w-62.5 md:px-4 md:py-4 md:text-base"
          />
        </div>
        <div class="-mt-8 px-10 md:mt-0 md:hidden md:px-0">
          <div
            class="tech-banner product-features-section relative right-0 bottom-[5vh] order-1 h-auto w-full overflow-hidden rounded-lg bg-gray-900 md:order-3 md:h-154.5 md:w-86.75 md:rounded-xl md:px-0 lg:absolute"

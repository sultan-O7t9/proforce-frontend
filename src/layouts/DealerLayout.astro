---
import { getImage } from "astro:assets";

import MainLayout from "@/layouts/MainLayout.astro";

import LoginBg from "@/assets/img/dealer-login-bg.png";
import MainButton from "@/components/buttons/MainButton.astro";

const optimizedBg = await getImage({
  src: LoginBg,
  format: "webp",
  width: 1266,
});

const { title } = Astro.props;
---

<MainLayout title={title} className="relative" headerTheme="dark">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={optimizedBg.src}
      fetchpriority="high"
    />
  </Fragment>

  <section class="dealer-login-section-container">
    <div
      class="max-container px-4 py-8 sm:px-8 md:px-16.5 md:py-17.5 lg:px-[clamp(1rem,6.2vw+1rem,100px)]"
    >
      <div
        class="bg-pf-gohst-white/50 s:px-8 flex flex-col items-center justify-center gap-8.75 rounded-lg px-4 py-8 md:gap-17.5 md:px-10 md:py-15"
      >
        <div class="flex flex-col gap-4 md:gap-6">
          <h1
            class="font-pf-mera-pro text-center text-xl tracking-[10%] uppercase md:text-2xl"
          >
            Dealer Portal
          </h1>
          <h6
            class="font-pf-galano-grotesque text-center text-sm font-medium tracking-[1%] md:text-base"
          >
            Access your dashboard to manage stock, order products, and scale
            your business.
          </h6>
        </div>
        <slot />
      </div>
    </div>
    <div
      class="max-container mb-8 px-4 md:mb-17.5 md:px-8.5 lg:px-[clamp(1rem,3.1vw+1rem,50px)]"
    >
      <div
        class="bg-cover bg-center bg-no-repeat p-4.5 md:p-11.5"
        style={`background-image: url('${optimizedBg.src}');`}
      >
        <div
          class="flex flex-col items-start gap-8 border border-[rgba(255,255,255,0.4)] px-8 py-11.5 sm:px-12 md:px-14 md:[border-image:linear-gradient(to_right,rgba(255,255,255,0.4)_0%,rgba(255,255,255,0)_100%)_1]"
        >
          <h2
            class="text-pf-yellow font-pf-mera-pro text-center text-lg tracking-[15%] uppercase sm:text-left sm:text-2xl"
          >
            Join Proforce
          </h2>
          <p
            class="font-pf-galano-grotesque max-w-111.25 text-center text-[15px] leading-6.5 font-normal text-white opacity-80 sm:text-left"
          >
            Become a certified Proforce partner. Grow your business with
            industry-leading products, transparent terms, and a commitment to
            shared success.
          </p>
          <MainButton
            label="Apply Now"
            href=""
            className="text-pf-navy flex justify-center border-white bg-white px-6 py-4 text-xs font-semibold tracking-[1%] transition-colors duration-200 hover:bg-transparent hover:text-white md:px-11 md:py-4 md:text-sm"
          />
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const header = document.querySelector(".main-header") as HTMLElement | null;
  const heroSectionCotnainer = document.querySelector(
    ".dealer-login-section-container",
  ) as HTMLElement | null;

  if (header && heroSectionCotnainer) {
    heroSectionCotnainer.style.paddingTop =
      header.getBoundingClientRect().height + "px";
  }
</script>

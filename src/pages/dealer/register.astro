---
import MainLayout from "@/layouts/MainLayout.astro";
import RegisterForm from "@/views/dealer/register/RegisterForm.svelte";

// const roleOptions = [
//   { name: "Distributor", value: "distributor" },
//   { name: "Installer", value: "installer" },
// ];
---

<MainLayout
  title={"Dealer Portal - Become a Partner"}
  className="relative"
  headerTheme="dark"
>
  <RegisterForm client:only />
</MainLayout>

<script>
  const header = document.querySelector(".main-header") as HTMLElement | null;
  const heroSectionCotnainer = document.querySelector(
    ".dealer-login-section-container",
  ) as HTMLElement | null;

  if (header && heroSectionCotnainer) {
    heroSectionCotnainer.style.paddingTop =
      header.getBoundingClientRect().height + "px";
  }
</script>

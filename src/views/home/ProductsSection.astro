---
const products = [
  {
    id: 1,
    title: "Proforce Phantom",
    thickness: "7 mil",
    warranty: "6 years",
    image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=900&q=80",
    features: [
      { id: 1, title: "Impact Resistance", description: "Absorbs harsh road debris impact." },
      { id: 2, title: "UV Protection", description: "Prevents paint fading and yellowing." },
      { id: 3, title: "HYDROPHOBIC", description: "Repels water and dirt effortlessly." },
      { id: 4, title: "SELF-HEALING", description: "Heals minor scratches automatically." },
    ]
  },
  {
    id: 2,
    title: "Proforce Phantom+",
    thickness: "8.5 mil",
    warranty: "10 years",
    image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=900&q=80",
    features: [
      { id: 1, title: "Impact Resistance", description: "Maximum defense against stone chips." },
      { id: 2, title: "UV Protection", description: "Advanced optical grade stabilizer." },
      { id: 3, title: "HYDROPHOBIC", description: "Extreme contact angle water shedding." },
      { id: 4, title: "SELF-HEALING", description: "Thermal activated scratch recovery." },
    ]
  },
  {
    id: 3,
    title: "Proforce Apex",
    thickness: "10 mil",
    warranty: "Lifetime",
    image: "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=900&q=80",
    features: [
      { id: 1, title: "Impact Resistance", description: "Military-grade ballistic protection." },
      { id: 2, title: "UV Protection", description: "Absolute block against sun damage." },
      { id: 3, title: "HYDROPHOBIC", description: "Superior slickness coating technology." },
      { id: 4, title: "SELF-HEALING", description: "Instant molecular structural repair." },
    ]
  },
];
---

<section class="products-section bg-pf-gohst-white min-h-screen relative z-1 overflow-hidden">
  <div class="max-container h-full pt-28 pb-16 flex flex-col justify-between">

    <div class="w-full max-w-5xl mx-auto px-4">
      <h4 class="font-pf-mera-pro text-pf-navy text-sm tracking-[25%] text-center mb-12">THE PROFORCE LINEUP</h4>


            <div class="mx-auto tab-buttons-container border border-pf-navy/50  rounded-[5px] p-1.25 max-w-175 mb-20">

                  <div class="relative flex">
                    <!-- Animated Background Pill -->
                    <div class=" cursor-pointer tab-indicator absolute top-0 bottom-0 left-0 bg-pf-navy rounded-[3px] transition-all duration-300 ease-out z-0 h-full"></div>

                    {products.map((product, index) => (
                      <button
                        class={`cursor-pointer tab-btn w-full relative z-10 px-6 h-14 rounded-full text-sm font-semibold transition-colors duration-300 flex-1 ${index === 0 ? 'text-white' : 'text-gray-600 '}`}
                        data-index={index}
                      >
                        {product.title}
                      </button>
                      <div class={"divider bg-[#9098A6] w-px h-12 self-center "+(index===products.length-1?'hidden':'')}></div>
                    ))}
                  </div>
            </div>


      <!-- Slider Main Wrapper -->
      <div class="slider-container relative w-full h-112.5">
        <div class="slides-wrapper relative w-full h-full">
          {products.map((product, index) => {
            const productName=product.title.split(" ")[1];
            return (

            <div
              class={`slide absolute transition-opacity duration-500 ${index === 0 ? 'active opacity-100 z-10' : 'opacity-0 invisible z-0'}`}
              data-index={index}
            >
                  <h5 class={"font-pf-mera-pro text-8xl text-center tracking-[15%] text-transparent [-webkit-text-stroke:1px_#21314D] text-shadow-[4px_0px_0px_rgba(33,49,77,0.04)] mb-10"}>{productName}</h5>
                  <h6 class=" flex items-center justify-center gap-4 uppercase font-semibold text-lg tracking-[2%] mb-16">
                        <span>{product.thickness} <span class="font-medium">Thickness</span></span>  <span class="block h-1.75 w-1.75 bg-pf-navy opacity-50 rounded-full"></span> <span>{product.warranty} <span class="font-medium">Warranty</span></span> </h6>
            <div class=" inset-0 w-full h-full grid grid-cols-1 md:grid-cols-3 items-center gap-6">

              <!-- Left Features (2 items) -->
              <div class="flex flex-col space-y-8 order-2 md:order-1 text-left md:text-right">
                {product.features.slice(0, 2).map((feature) => (
                  <div class="feature-item">
                    <h3 class="slide-feature-title text-pf-navy font-bold text-base md:text-lg mb-1 font-pf-mera-pro">{feature.title}</h3>
                    <p class="slide-feature-desc text-gray-500 text-xs md:text-sm">{feature.description}</p>
                  </div>
                ))}
              </div>

              <!-- Center Image with Blur Transition -->
              <div class="slide-image-wrapper flex flex-col items-center justify-center relative w-full h-72 md:h-full rounded-2xl overflow-hidden shadow-xl order-1 md:order-2">
                <img
                  src={product.image}
                  alt={product.title}
                  class={`slide-image w-full h-full object-cover transition-all duration-700 ease-out ${index === 0 ? 'filter-none scale-100' : 'blur-xl scale-110'}`}
                />
                <!-- Optional Badges overlay -->
                <div class="absolute bottom-4 left-4 right-4 bg-black/40 backdrop-blur-md px-4 py-2 rounded-xl flex justify-between text-white text-xs font-medium">
                  <span>Thickness: <strong class="slide-thickness">{product.thickness}</strong></span>
                  <span>Warranty: <strong class="slide-warranty">{product.warranty}</strong></span>
                </div>
              </div>

              <!-- Right Features (2 items) -->
              <div class="flex flex-col space-y-8 order-3 md:order-3 text-left">
                {product.features.slice(2, 4).map((feature) => (
                  <div class="feature-item">
                    <h3 class="slide-feature-title text-pf-navy font-bold text-base md:text-lg mb-1 font-pf-mera-pro">{feature.title}</h3>
                    <p class="slide-feature-desc text-gray-500 text-xs md:text-sm">{feature.description}</p>
                  </div>
                ))}
              </div>
                  </div>

            </div>
          )
          })}
        </div>
      </div>
    </div>

    <!-- Dot Navigation (No scaling, color transition only) -->
    <div class="dots-container flex justify-center items-center gap-3 mt-12">
      {products.map((_, index) => (
        <button
          class={`dot w-3 h-3 rounded-full transition-colors duration-300 ${index === 0 ? 'bg-pf-navy' : 'bg-gray-300 hover:bg-gray-400'}`}
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        ></button>
      ))}
    </div>

  </div>
</section>


<script>
      import { gsap } from "@/lib/gsap";
  document.addEventListener("DOMContentLoaded", () => {


    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabIndicator = document.querySelector('.tab-indicator') as HTMLElement;
    const sliderContainer = document.querySelector('.slider-container');

    let currentIndex = 0;
    const totalSlides = slides.length;
    let isAnimating = false;

    // Position initial background pill indicator under the first tab button
    function updateTabIndicator(index: number) {
      const activeBtn = tabBtns[index] as HTMLElement;
      if (tabIndicator && activeBtn) {
        tabIndicator.style.width = `${activeBtn.offsetWidth}px`;
        tabIndicator.style.left = `${activeBtn.offsetLeft}px`;
      }
    }

    // Set initial position
    updateTabIndicator(0);
    window.addEventListener('resize', () => updateTabIndicator(currentIndex));

    // Cache original strings for feature scramble text
    slides.forEach(slide => {
      const fTitles = slide.querySelectorAll('.slide-feature-title');
      const fDescs = slide.querySelectorAll('.slide-feature-desc');

      fTitles.forEach(el => el.dataset.originalText = el.textContent?.trim() || '');
      fDescs.forEach(el => el.dataset.originalText = el.textContent?.trim() || '');
    });

    function goToSlide(newIndex: number) {
      if (isAnimating || newIndex === currentIndex) return;
      isAnimating = true;

      const currentSlide = slides[currentIndex];
      const nextSlide = slides[newIndex];

      // 1. Handle Slide Visibility & Blur Transitions
      currentSlide.classList.remove('active', 'opacity-100', 'z-10');
      currentSlide.classList.add('opacity-0', 'invisible', 'z-0');

      const oldImg = currentSlide.querySelector('.slide-image');
      oldImg?.classList.remove('filter-none', 'scale-100');
      oldImg?.classList.add('blur-xl', 'scale-110');

      nextSlide.classList.remove('opacity-0', 'invisible', 'z-0');
      nextSlide.classList.add('active', 'opacity-100', 'z-10');

      const nextImg = nextSlide.querySelector('.slide-image');
      nextImg?.classList.remove('blur-xl', 'scale-110');
      nextImg?.classList.add('filter-none', 'scale-100');

      // 2. Update Tabs & Indicator
      tabBtns[currentIndex].classList.remove('text-white');
      tabBtns[currentIndex].classList.add('text-gray-600');
      tabBtns[newIndex].classList.add('text-white');
      tabBtns[newIndex].classList.remove('text-gray-600');
      updateTabIndicator(newIndex);

      // 3. Update Dots State (Color change only, no scale)
      dots[currentIndex].classList.remove('bg-pf-navy');
      dots[currentIndex].classList.add('bg-gray-300');
      dots[newIndex].classList.add('bg-pf-navy');
      dots[newIndex].classList.remove('bg-gray-300');

      // 4. Trigger Scramble Text Animation on Features
      const nextTitles = nextSlide.querySelectorAll('.slide-feature-title');
      const nextDescs = nextSlide.querySelectorAll('.slide-feature-desc');

      nextTitles.forEach(el => el.textContent = "");
      nextDescs.forEach(el => el.textContent = "");

      // Scramble sequence duration tracker
      let completedAnimations = 0;
      const totalAnimations = nextTitles.length + nextDescs.length;

      function checkComplete() {
        completedAnimations++;
        if (completedAnimations >= totalAnimations) {
          currentIndex = newIndex;
          isAnimating = false;
        }
      }

      nextTitles.forEach(el => {
        gsap.to(el, {
          duration: 0.8,
          scrambleText: { text: el.dataset.originalText || '', chars: "uppercase", speed: 0.3 },
          onComplete: checkComplete
        });
      });

      nextDescs.forEach(el => {
        gsap.to(el, {
          duration: 1.0,
          scrambleText: { text: el.dataset.originalText || '', chars: "lowerCase", speed: 0.4 },
          onComplete: checkComplete
        });
      });
    }

    // Event Listeners for Tab Buttons
    tabBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => goToSlide(index));
    });

    // Event Listeners for Dots
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goToSlide(index));
    });

    // Touch / Swipe Support (Mobile & Medium Screens)
    let touchStartX = 0;
    let touchEndX = 0;

    sliderContainer?.addEventListener('touchstart', (e: any) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    sliderContainer?.addEventListener('touchend', (e: any) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeThreshold = 50;
      if (touchStartX - touchEndX > swipeThreshold) {
        let nextIndex = (currentIndex + 1) % totalSlides;
        goToSlide(nextIndex);
      } else if (touchEndX - touchStartX > swipeThreshold) {
        let prevIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        goToSlide(prevIndex);
      }
    }
  });
</script>

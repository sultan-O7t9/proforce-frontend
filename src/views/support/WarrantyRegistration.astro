---
import AlertMessage from "@/components/AlertMessage.astro";
import MainButton from "@/components/buttons/MainButton.astro";
import Checkbox from "@/components/forms/Checkbox.astro";
import Input from "@/components/forms/Input.astro";
import RadioGroup from "@/components/forms/RadioGroup.astro";
import Select from "@/components/forms/Select.astro";
import { ROUTES } from "@/lib/site";

const countryOptions = [
  { label: "United States", value: "us" },
  { label: "Canada", value: "ca" },
  { label: "United Kingdom", value: "uk" },
];
const result=false;
---

<div
  id="tab-registration"
  class="tab-panel bg-pf-gohst-white/50 rounded-lg px-4 py-8 sm:px-8 md:px-10 md:py-18.5 lg:px-15"
>
 {!result? <h3
    class="font-pf-galano-grotesque mb-8 md:mb-15 text-xl md:text-2xl font-bold tracking-[2%] capitalize"
  >
    Activate your Warranty
  </h3>
  <RadioGroup containerClass="w-full max-w-168.5 justify-between" />
  <form class="font-pf-galano-grotesque mt-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:gap-15">
      <div class="flex flex-1 flex-col gap-6">
        <Input
          label="Customer Name"
          placeholder="Full Name"
          id="customer-name"
          name="customer-name"
        />
        <Input
          label="Email"
          placeholder="Customer Email Address"
          id="customer-email"
          name="customer-email"
          type="email"
        />
        <Input
          label="Mobile Number"
          placeholder="Customer WhatsApp Number"
          id="customer-phone"
          name="customer-phone"
        />
        <Select
          label="Country"
          placeholder="Select Country"
          id="installer-country"
          name="installer-country"
          options={countryOptions}
        />
        <Select
          label="City"
          placeholder="Select City"
          id="installer-city"
          name="installer-city"
          options={countryOptions}
        />
        <Select
          options={countryOptions}
          label="Installer"
          placeholder="Select Studio"
          id="installer"
          name="installer"
        />
      </div>
      <div class="flex flex-1 flex-col gap-6">
        <Input
          label="Car Brand"
          placeholder="Car Brand"
          id="car-brand"
          name="car-brand"
        />
        <Input
          label="Car Model"
          placeholder="Car Model"
          id="car-model"
          name="car-model"
          type="text"
        />
        <Input
          label="Chasis / Registration Number"
          placeholder="Chasis / Registration Number"
          id="chasis-number"
          name="chasis-number"
        />
        <Input
          label="Product Roll ID"
          placeholder="Enter ID mentioned on PFF Roll"
          id="product-roll-id"
          name="product-roll-id"
        />
        <Input
          label="Warranty Number"
          placeholder="Warranty Number"
          id="warranty-number"
          name="warranty-number"
        />
        <Input
          label="Date of Application"
          placeholder="Select date when the PFF was applied"
          id="application-date"
          name="application-date"
        />
      </div>
    </div>
    <Checkbox
      containerClass="mb-8 md:mb-15 mt-4"
      id="vehicle3"
      name="vehicle3"
      value="Boat"
      labelElement={(
        <span>
          I agree with the Proforce Warranty{" "}
          <a
            href={ROUTES.TERMS.href}
            aria-label={ROUTES.TERMS.name}
            class="text-pf-navy-dark font-semibold"
          >
            Terms and Conditions.
          </a>
        </span>
      )}
    />
    <MainButton
      label="Submit for Registration"
      href=""
      className="bg-pf-navy hover:text-pf-navy border-pf-navy mx-auto flex max-w-95 justify-center px-5 py-3.5 text-xs font-semibold tracking-[1%] transition-colors duration-200 hover:bg-transparent sm:w-4/5 md:px-4 md:py-4 md:text-sm"
    />
  </form>:
  <AlertMessage title="Record Not Found" type="error" message="Please ensure the entered details are correct.">
    <Fragment slot="action">
     <MainButton
      label="Try Again"
      href=""
      className="bg-pf-navy hover:text-pf-navy border-pf-navy mx-auto flex max-w-62.5 justify-center px-5 py-3.5 text-xs font-semibold tracking-[1%] transition-colors duration-200 hover:bg-transparent sm:w-4/5 md:px-4 md:py-4 md:text-sm mt-10"
      />
      </Fragment>
  </AlertMessage>
  }
</div>

---
/**
 * A small reusable component demonstrating Astro's typed-Props +
 * <slot /> pattern: the button's visual variant is controlled by a
 * prop, while its label/content is provided by whatever the caller
 * puts between the opening and closing tags.
 *
 * Usage:
 *   <Button href="/about">Learn more</Button>
 *   <Button href="/contact" variant="secondary">Contact us</Button>
 */
interface Props {
  href: string;
  variant?: "primary" | "secondary";
}

const { href, variant = "primary" } = Astro.props;

const styles = {
  primary: "bg-brand-500 text-white hover:bg-brand-600",
  secondary: "bg-slate-100 text-slate-900 hover:bg-slate-200",
};
---

<a
  href={href}
  class:list={[
    "inline-block rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors",
    styles[variant],
  ]}
>
  <slot />
</a>

---
/**
 * Every route in src/pages/ is a real, statically-generated page — this
 * file becomes "/" at build time as plain HTML, with zero client-side
 * JavaScript shipped (nothing here uses a `client:*` directive, and
 * nothing needs to: it's all static content).
 */
import { getImage } from "astro:assets";

import MainLayout from "@/layouts/MainLayout.astro";
import BenefitsSection from "@/views/home/BenefitsSection.astro";
import HeroSection from "@/views/home/HeroSection.astro";
import OnefilmSection from "@/views/home/OnefilmSection.astro";
import ProductsSection from "@/views/home/ProductsSection.astro";
import BecomeInstallerSection from "@/views/home/BecomeInstallerSection.astro";
import MapSection from "@/views/home/MapSection.astro";

import HeroBg from "@/assets/img/home/bg-temp.png";
import LoaderScreen from "@/components/LoaderScreen.astro";

const optimizedBg = await getImage({
  src: HeroBg,
  format: "webp",
  width: 1366,
});
---

<MainLayout title="Home" className="relative">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={optimizedBg.src}
      fetchpriority="high"
    />
  </Fragment>
  <!-- <LoaderScreen /> -->
  <HeroSection bgUrl={optimizedBg.src} />
  <OnefilmSection />
  <ProductsSection />
  <MapSection />
  <BenefitsSection />
  <BecomeInstallerSection />
</MainLayout>

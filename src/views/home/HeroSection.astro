---
import MainButton from "@/components/buttons/MainButton.astro";
import { ROUTES } from "@/lib/site";
import { twMerge } from "tailwind-merge";

interface Props {
  bgUrl: string;
  className?: string;
}

const { bgUrl, className } = Astro.props;
---

<section
  class={twMerge(
    "bg-pf-navy hero-section-container sticky top-0 flex h-screen flex-col items-start justify-center bg-cover bg-right px-8 py-5 md:px-12 md:py-8.75 lg:px-[clamp(1rem,6.2vw+1rem,100px)]",
    className,
  )}
  style={`background-image: url('${bgUrl}');`}
>
  <div class="max-container flex w-full flex-col gap-12 md:gap-20">
    <h2
      class="font-pf-mera-pro flex flex-col text-[clamp(1rem,7vw,45px)] leading-10 tracking-[15%] text-white md:tracking-[18%] lg:leading-20"
    >
      <span class="animate-slide-up opacity-0"> PRISTINE. </span>
      <span class="animate-slide-up opacity-0"> INVISIBLE. </span>
      <span
        class="animate-slide-up text-transparent opacity-0 [-webkit-text-stroke:1.5px_white] lg:[-webkit-text-stroke:2px_white]"
      >
        INVINCIBLE.
      </span>
    </h2>
    <div class="flex flex-col justify-start gap-4 self-start">
      <MainButton label="Explore Products" showAero />
      <MainButton
        label="Find an Installer"
        showAero
        href={ROUTES.INSTALLERS.href}
        className="text-pf-yellow border-pf-yellow md:hidden"
        aeroClass="fill-pf-yellow"
      />
    </div>
  </div>
</section>

<script>
  const header = document.querySelector(".main-header") as HTMLElement | null;
  const heroSectionCotnainer = document.querySelector(
    ".hero-section-container",
  ) as HTMLElement | null;

  if (header && heroSectionCotnainer) {
    heroSectionCotnainer.style.paddingTop =
      header.getBoundingClientRect().height + "px";
  }
</script>

<script>
  import { gsap } from "../lib/gsap";
  import { $activeTab, setActiveTab } from "@/views/support/stores/tabsStore";

  // Header and container padding calculation
  const header = document.querySelector(".main-header") as HTMLElement | null;
  const heroSectionCotnainer = document.querySelector(
    ".support-container",
  ) as HTMLElement | null;

  if (header && heroSectionCotnainer) {
    heroSectionCotnainer.style.paddingTop =
      header.getBoundingClientRect().height + "px";
  }

  const container = document.querySelector(".tab-buttons-container");

  if (container) {
    const indicator = container.querySelector(".tab-indicator");
    const buttons = container.querySelectorAll(".tab-btn");
    const panels = document.querySelectorAll(".tab-panel");
    console.log(panels);

    function updateIndicator(activeBtn: HTMLButtonElement, animate = true) {
      const targetWidth = activeBtn.offsetWidth;
      const targetX = activeBtn.offsetLeft;

      if (animate) {
        gsap.to(indicator, {
          width: targetWidth,
          x: targetX,
          duration: 0.4,
          ease: "power2.out",
        });
      } else {
        gsap.set(indicator, {
          width: targetWidth,
          x: targetX,
        });
      }
    }

    // Function to switch content panels with a smooth GSAP fade
    function switchPanel(targetTabId: string) {
      panels.forEach((panel) => {
        const el = panel as HTMLElement;
        if (panel.id === targetTabId) {
          el.style.display = "block";
          gsap.fromTo(
            el,
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" },
          );
        } else {
          gsap.to(el, {
            opacity: 0,
            y: -10,
            duration: 0.2,
            ease: "power2.in",
            onComplete: () => {
              el.style.display = "none";
            },
          });
        }
      });
    }

    // Subscribe to Nano Store changes (reactive state management)
    $activeTab.subscribe((currentTab) => {
      buttons.forEach((b) => {
        const btn = b as HTMLButtonElement;
        const btnTab = btn.getAttribute("data-tab");

        if (btnTab === currentTab) {
          btn.classList.remove("text-gray-65");
          btn.classList.add("text-white");
          updateIndicator(btn, true);
        } else {
          btn.classList.remove("text-white");
          btn.classList.add("text-gray-65");
        }
      });

      switchPanel(currentTab);
    });

    // Handle click events -> triggers store update
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetTab = btn.getAttribute("data-tab") as
          "tab-registration" | "tab-verification";
        if (targetTab) {
          setActiveTab(targetTab); // Updates store, which triggers subscription above
        }
      });
    });

    // Initialize initial state matching store default instantly
    const initialTab = $activeTab.get();
    const initialBtn = container.querySelector(
      `.tab-btn[data-tab="${initialTab}"]`,
    ) as HTMLButtonElement | null;

    if (initialBtn) {
      updateIndicator(initialBtn, false);
    }

    panels.forEach((panel) => {
      const el = panel as HTMLElement;
      if (panel.id === initialTab) {
        el.style.display = "block";
        el.style.opacity = "1";
      } else {
        el.style.display = "none";
        el.style.opacity = "0";
      }
    });

    // Recalculate indicator on window resize
    window.addEventListener("resize", () => {
      const currentActive = container.querySelector(
        ".tab-btn.text-white",
      ) as HTMLButtonElement | null;
      if (currentActive) {
        updateIndicator(currentActive, false);
      }
    });
  }
</script>

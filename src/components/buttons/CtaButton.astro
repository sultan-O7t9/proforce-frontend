---
import { twMerge } from "tailwind-merge";

interface Props {
  label: string;
  href: string;
  className?: string;
  variant?: "outlined" | "filled";
}
const { label, href, className, variant = "filled" } = Astro.props;
---

<a
  href={href}
  class={twMerge(
    "cursor-pointer overflow-hidden block text-[clamp(0.75rem,1.3vw,1rem)] uppercase tracking-[1%] whitespace-nowrap text-pf-yellow px-[clamp(1.25rem,2.2vw,1.9rem)]   py-[clamp(0.75rem,1.2vw,1rem)] rounded-full border-pf-yellow border bg-[rgba(6,10,20,0.1)] backdrop-blur-[10px] group hover:text-pf-navy relative btn-cta group",
    variant === "filled"
      ? "bg-pf-yellow backdrop-blur-none text-pf-navy hover:text-pf-yellow"
      : "",
    className,
  )}
>
  <div
    class={twMerge(
      "hidden md:block rounded-full circle-util aspect-square w-[200%] bg-pf-yellow absolute z-0 top-0 left-0 scale-0 pointer-events-none -translate-3/6 -translate-y-1/2",
      variant === "filled" ? "bg-pf-navy" : "",
    )}
  >
  </div>
  <span
    class={twMerge(
      "pointer-events-none relative z-10 group-hover:text-pf-navy",
      variant === "filled" ? "  group-hover:text-pf-yellow" : "",
    )}
  >
    {label}
  </span>
</a>

<script>
  import { gsap } from "../../lib/gsap";

  document.addEventListener("DOMContentLoaded", () => {
    // 2. Button Hover Effect
    const buttons = document.querySelectorAll(
      ".btn-cta",
    ) as NodeListOf<HTMLAnchorElement>;

    buttons.forEach((btnCta) => {
      // const btnCta = document.querySelector(".btn-cta") as HTMLElement | null;
      const circle = btnCta?.querySelector(
        ".circle-util",
      ) as HTMLElement | null;
      console.log(btnCta, circle);

      if (btnCta && circle) {
        console.log("Animating");
        const animation = gsap.to(circle, {
          scale: 2,
          duration: 0.5,
          ease: "power1.inOut",
          paused: true, // Keep it paused initially
        });

        btnCta?.addEventListener("mouseover", (e: MouseEvent) => {
          console.log("EVENT");
          const dimensions = btnCta.getBoundingClientRect();

          // Position the circle instantly before playing forward
          circle.style.top = `${e.clientY - dimensions.top}px`;
          circle.style.left = `${e.clientX - dimensions.left}px`;
          console.log("first");
          animation.play();
          console.log(animation);
        });

        btnCta.addEventListener("mouseleave", () => {
          animation.timeScale(2).reverse();
        });
      }
    });
  });
</script>

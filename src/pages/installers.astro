---
import MainLayout from "@/layouts/MainLayout.astro";
import InstallerCard from "@/components/InstallerCard.svelte";
import InstallerMapSearch from "@/views/installers/InstallerMapSearchLeaflet.svelte";
import { INSTALLERS, MAPS_API_KEY } from "@/lib/site";

interface Installer {
  name: string;
  location: string;
  phone: string;
  address: string;
}
---

<MainLayout
  title={"Find an Installer"}
  className="relative"
  headerTheme="light"
  ctaVariant="filled"
  headerClass="bg-pf-navy-dark border-transparent"
>
  <section class="pb-24">
    <!-- Interactive Map & Search Component -->
    <InstallerMapSearch
      client:load
      installersData={INSTALLERS}
      googleMapsApiKey={MAPS_API_KEY}
    />

    <!-- Lists Grid Section -->
  </section>
</MainLayout>

<script></script>

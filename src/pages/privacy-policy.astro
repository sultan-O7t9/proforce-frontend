---
import InfoPageLayout from "@/layouts/InfoPageLayout.astro";
import MainLayout from "@/layouts/MainLayout.astro";

import { PRIVACY_POLICY } from "@/lib/site";
---

<InfoPageLayout title="Privacy Policy">
  {
    PRIVACY_POLICY
      ? PRIVACY_POLICY.map((policy) => (
          <div>
            <h3 class="text-pf-black mb-2 text-xl font-semibold tracking-[-1%] opacity-90 md:mb-5 md:text-2xl">
              {policy.heading}
            </h3>
            <p class="text-pf-black text-base leading-8 opacity-80 md:text-xl">
              {policy.description}
            </p>
            {policy.bullets ? (
              <ul class="mt-4 flex list-disc flex-col gap-3 pl-5 md:mt-9 md:gap-5">
                {policy.bullets.map((bullet) => (
                  <li class="text-pf-black text-base leading-8 font-normal opacity-80 md:text-xl">
                    <b class="font-medium">{bullet.heading} </b>
                    {bullet.description}
                  </li>
                ))}
              </ul>
            ) : null}
          </div>
        ))
      : null
  }
</InfoPageLayout>

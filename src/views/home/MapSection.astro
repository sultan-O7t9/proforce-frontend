---
import MapImage from "@/assets/img/home/map.svg"
import MainButton from "@/components/buttons/MainButton.astro"
---

<section class=" bg-pf-navy-gradient relative z-1 -m-2">
<div class="max-container h-full py-16 flex flex-col gap-6 items-center justify-center">
<h4 class="font-pf-mera-pro text-white text-xs md:text-sm tracking-[25%] text-center px-8 mb-7 leading-6">
      CERTIFIED INSTALLATION
</h4>
<div class="relative max-w-261.25 w-full px-4 md:px-40">
      <img src={MapImage.src} alt="Proforce Installer Locations Map - Worldwide"/>
      <div class="absolute z-1 top-6 md:top-12.75 right-7 md:right-16 bg-pf-navy-dark-transparent w-24 md:w-37.5 aspect-15/13 border border-[rgba(255,255,255,0.3)] rounded-2xl flex flex-col items-center justify-center pb-2 md:pb-4">
             <h5 class="text-3xl md:text-[45px] font-pf-galano-grotesque font-bold text-pf-yellow tracking-[6px]">12</h5>
             <h6 class="text-white font-pf-galano-grotesque font-semibold text-[10px] md:text-xs uppercase tracking-[8%]">Countries</h6>
            </div>
      <div class="absolute z-1 bottom-5 md:bottom-26 left-8 md:left-33.75 bg-pf-navy-dark-transparent w-24 md:w-37.5 aspect-15/13 border border-[rgba(255,255,255,0.3)] rounded-2xl flex flex-col items-center justify-center pb-2 md:pb-4">
      <h5 class="text-3xl md:text-[45px] font-pf-galano-grotesque font-bold text-pf-yellow tracking-[2px] md:tracking-[6px]">60+</h5>
             <h6 class="text-white font-pf-galano-grotesque font-semibold text-[10px] md:text-xs uppercase tracking-[8%]">Installers</h6>
      </div>
</div>
<div>

      <MainButton label="Find your nearest Installer" showAero href="" className="text-pf-yellow border-pf-yellow mx-auto" aeroClass="fill-pf-yellow" />
</div>
</div>
</section>

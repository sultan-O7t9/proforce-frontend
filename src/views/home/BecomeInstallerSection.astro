---
import MainButton from "@/components/buttons/MainButton.astro";
import { ROUTES } from "@/lib/site";
---

<section class="benefits-section bg-pf-white-v2 relative z-1 -m-2">
  <div class="max-container h-full p-12 md:p-20">
    <div
      class="border-pf-navy flex flex-col items-center justify-center gap-6 border py-6 md:gap-16.5 md:p-12"
    >
      <h4
        class="font-pf-mera-pro text-pf-navy px-4 text-center text-xs leading-6 tracking-[25%] md:text-sm"
      >
        THE PROFORCE DEALER PORTAL
      </h4>
      <h6
        class="font-pf-galano-grotesque text-pf-navy max-w-223.5 px-6 text-center text-2xl leading-10 font-bold uppercase md:px-0 md:text-5xl md:leading-16"
      >
        ALIGN YOUR BUSINESS WITH THE ULTIMATE PROTECTIVE FORCE
      </h6>
      <div>
        <MainButton
          label="Become an Installer"
          href={ROUTES.INSTALLERS.href}
          className="bg-pf-navy hover:bg-pf-light-navy hover:text-pf-navy border-pf-navy px-5 py-3 font-semibold tracking-[1%] transition-colors duration-200 md:px-14 md:py-5"
        />
      </div>
    </div>
  </div>
</section>

---
import { NAV_LINKS, ROUTES } from "@/lib/site";
import { twMerge } from "tailwind-merge";
import CtaButton from "./buttons/CtaButton.astro";

const { theme } = Astro.props;

const navToggleStyles = twMerge(
  "rounded-2xl bg-pf-yellow border-2 border-pf-yellow",
  theme === "dark" ? "border-pf-navy bg-pf-navy" : "",
);

const products = [
  { name: "Proforce Phantom", slug: "proforce-phantom" },
  { name: "Proforce Phantom+", slug: "proforce-phantom-plus" },
  { name: "Proforce Apex", slug: "proforce-apex" },
];
---

<nav class="md:hidden">
  <button
    aria-label="Toggle menu"
    class={twMerge(
      "header-menu-toggle flex flex-col justify-center items-center gap-1.25 h-12 w-12 bg-pf-navy/10 border border-pf-yellow backdrop-blur-[30px] rounded-full cursor-pointer group",
      theme === "dark" ? "bg-transparent border-transparent" : "",
    )}
  >
    <div class="flex items-center gap-0.5">
      <div class:list={["line w-1", navToggleStyles]}></div>
      <div
        class:list={[
          "line-cross line-cross-1 w-5 origin-right",
          navToggleStyles,
        ]}
      >
      </div>
    </div>
    <div class="flex items-center gap-0.5">
      <div class:list={["line w-1.25", navToggleStyles]}></div>
      <div class:list={["line w-4.75", navToggleStyles]}></div>
    </div>
    <div class="flex items-center gap-0.5">
      <div class:list={["line w-1.5", navToggleStyles]}></div>
      <div
        class:list={[
          "line-cross line-cross-2 w-4.5 origin-right",
          navToggleStyles,
        ]}
      >
      </div>
    </div>
  </button>

  <!-- Backdrop -->
  <div
    class="backdrop bg-pf-yellow pointer-events-none fixed top-0 left-0 z-50 h-screen w-screen translate-x-full px-8 py-5 md:px-10 md:pt-8.75 md:pb-5 lg:px-[clamp(1rem,4vw+1rem,70px)]"
  >
    <div
      class="backdrop-2 from-pf-navy to-pf-navy-dark bg-pf-navy absolute top-0 left-0 flex h-full w-full translate-x-[120%] flex-col bg-linear-to-r px-10 pt-10"
    >
      <div class="mb-8 flex items-center justify-between">
        <a
          href={ROUTES.HOME.href}
          aria-label="Proforce Logo"
          class="text-lg font-bold tracking-tight text-slate-900 transition-transform duration-300 hover:scale-95"
        >
          <img
            src="/images/icons/proforce-logo-white-1.svg"
            alt={"Proforce Logo"}
            class="h-8 w-auto object-cover lg:h-10"
          />
        </a>

        <button
          aria-label="Menu Close Button"
          class={twMerge(
            "menu-close-btn flex flex-col justify-center items-center gap-1.25 h-12 w-12 bg-pf-navy/10 border-white border group hover:border-pf-yellow backdrop-blur-[30px] rounded-full cursor-pointer group",
          )}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            class="group-hover:stroke-pf-yellow h-8 w-8 stroke-white"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <nav class="flex flex-1 flex-col overflow-y-auto">
        <ul class="flex flex-col items-center justify-center gap-8 py-4">
          <!-- Products Accordion Item -->
          <li class="relative flex w-full flex-col items-center text-center">
            <button
              type="button"
              class="mobile-products-trigger font-pf-mera-pro hover:text-pf-yellow relative inline-flex cursor-pointer items-center gap-2 text-[clamp(10px,3vw+6px,14px)] font-semibold tracking-[15%] text-white uppercase transition-colors duration-300 after:block after:h-0.5 after:w-full after:origin-right after:scale-x-0 after:rounded-lg after:bg-transparent after:transition-transform after:duration-300 after:content-[''] hover:after:origin-left hover:after:scale-x-100"
            >
              {ROUTES.PRODUCTS.name}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                class="accordion-arrow hover:text-pf-yellow absolute -right-4 h-4 w-4 shrink-0 text-white transition-colors"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </button>

            <!-- Accordion Submenu -->
            <div
              class="mobile-products-accordion flex max-h-0 w-full max-w-[220px] flex-col items-center overflow-hidden"
            >
              <div class="flex w-full flex-col items-center gap-4 pt-4">
                {
                  products.map((product) => (
                    <a
                      href={ROUTES.PRODUCTS(product.slug, product.name).href}
                      class="hover:text-pf-yellow text-xs font-normal tracking-[1%] whitespace-nowrap text-white transition-colors"
                    >
                      {product.name.split(" ")[0]}{" "}
                      <span
                        class={
                          product.name.split(" ")[1].toLowerCase() === "apex"
                            ? "font-pf-mera-pro uppercase"
                            : ""
                        }
                      >
                        {product.name.split(" ")[1]}
                      </span>
                    </a>
                  ))
                }
              </div>
            </div>
          </li>

          {
            NAV_LINKS.map((link) => (
              <li class="text-center">
                <a
                  href={link.href}
                  class="font-pf-mera-pro hover:text-pf-yellow text-[clamp(10px,3vw+6px,14px)] font-semibold tracking-[15%] text-white uppercase transition-colors duration-300 after:block after:h-0.5 after:w-full after:origin-right after:scale-x-0 after:rounded-lg after:bg-transparent after:transition-transform after:duration-300 after:content-[''] hover:after:origin-left hover:after:scale-x-100"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
          <li class="font-pf-galano-grotesque">
            <CtaButton
              label="Find Installer"
              href={ROUTES.INSTALLERS.href}
              variant={"filled"}
              className="text-lg font-semibold hover:text-white"
            />
          </li>
        </ul>
      </nav>

      <div class="m-0 h-[0.6px] w-full bg-white p-0 opacity-40"></div>
      <div
        class="max-container relative z-1 flex items-center justify-between py-8 text-white"
      >
        <h6
          class="font-pf-galano-grotesque text-pf-white-80 text-center text-sm tracking-[2%]"
        >
          © {new Date().getFullYear()}
          <a
            href={ROUTES.HOME.href}
            class="hover:text-pf-yellow cursor-pointer transition-colors duration-300"
            >Proforce.</a
          > All Rights Reserved.
        </h6>
      </div>
    </div>
  </div>
</nav>

<script>
  import { gsap } from "../lib/gsap";

  const menuToggle = document.querySelector(".header-menu-toggle");
  const menuCloseBtn = document.querySelector(".menu-close-btn");

  const productsTrigger = document.querySelector(
    ".mobile-products-trigger",
  ) as HTMLButtonElement;
  const productsAccordion = document.querySelector(
    ".mobile-products-accordion",
  );
  const accordionArrow = document.querySelector(".accordion-arrow");

  let isAccordionOpen = false;

  productsTrigger?.addEventListener("click", () => {
    isAccordionOpen = !isAccordionOpen;

    if (isAccordionOpen) {
      // Rotate Arrow & Expand Accordion
      gsap.to(accordionArrow, {
        rotate: 180,
        duration: 0.3,
        ease: "power2.out",
      });
      gsap.to(productsAccordion, {
        maxHeight: "166px",
        duration: 0.3,
        ease: "power2.out",
        onComplete: () => {
          // Enable overflow-y-auto only AFTER animation completes to avoid mid-transition scrollbars
          if (productsAccordion) {
            (productsAccordion as HTMLElement).style.overflowY = "auto";
          }
        },
      });
    } else {
      // Hide scrollbar immediately on collapse so it doesn't flicker while reversing
      if (productsAccordion) {
        (productsAccordion as HTMLElement).style.overflowY = "hidden";
      }
      gsap.to(accordionArrow, { rotate: 0, duration: 0.3, ease: "power2.in" });
      gsap.to(productsAccordion, {
        maxHeight: 0,
        duration: 0.3,
        ease: "power2.in",
      });
    }
  });

  menuToggle?.addEventListener("click", () => {
    document.body.style.overflow = "hidden";

    gsap
      .timeline({
        onStart: () => {
          productsTrigger?.click();
          // Put your code here
        },
      })
      .to(".backdrop", {
        x: 0,
        pointerEvents: "auto",
        duration: 1,
      })
      .to(
        ".backdrop-2",
        {
          x: 0,
          pointerEvents: "auto",
          duration: 1,
          ease: "power4.out",
        },
        "<0.25",
      );
  });

  menuCloseBtn?.addEventListener("click", () => {
    document.body.style.overflow = "";

    if (isAccordionOpen) {
      isAccordionOpen = false;
      gsap.set(productsAccordion, { maxHeight: 0, overflowY: "hidden" });
      gsap.set(accordionArrow, { rotate: 0 });
    }

    gsap
      .timeline()
      .to(".backdrop-2", { x: "120%", pointerEvents: "none", duration: 0.5 })
      .to(
        ".backdrop",
        {
          x: "100%",
          pointerEvents: "none",
          duration: 0.5,
        },
        "<",
      );
  });
</script>

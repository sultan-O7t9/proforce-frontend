        </div>
        <!-- <div
          class="tech-banner product-features-section relative right-0 bottom-[5vh] order-1 h-auto w-full overflow-hidden rounded-xl bg-gray-900 md:order-3 md:h-154.5 md:w-86.75 lg:absolute"
        >
          <img
            src={TempProductBg.src}
            class="h-full w-full object-cover"
            alt="Technology background"
          />
        </div> -->
      </div>
    </div>
    <!-- Product Specs-->
    <div class="bg-pf-gohst-white">
      <div
        class="max-container active z-10 col-start-1 row-start-1 px-8 pt-12 pb-14 opacity-100 transition-opacity duration-500 md:px-25 md:pt-25 md:pb-20"
      >
        <h6

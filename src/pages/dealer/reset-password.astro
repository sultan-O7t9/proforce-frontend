---
import MainButton from "@/components/buttons/MainButton.astro";
import Input from "@/components/forms/Input.astro";
import DealerLayout from "@/layouts/DealerLayout.astro";
import { ROUTES } from "@/lib/site";


---

<DealerLayout title="Dealer Portal - Reset Passord">
    <form class="flex flex-col items-center gap-4.5 font-pf-galano-grotesque w-[clamp(280px,100%,480px)]">
            <!-- Password Field -->
            <Input name="password" placeholder={"New Password"} id="password" type={"password"} label="New Password" />
            <Input name="password" placeholder={"Confirm Password"} id="confirm-password" type={"password"} label="Confirm Password" />
<!-- Submit Button (Bonus for completeness) -->
               <MainButton label="Reset Password" href="" className="mt-4 md:mt-9 text-xs md:text-sm py-3.5 md:py-4 px-5 md:px-14 sm:w-4/5 min-w-3xs flex justify-center font-semibold tracking-[1%] bg-pf-navy transition-colors duration-200 hover:bg-transparent hover:text-pf-navy border-pf-navy"/>


        </form>
</DealerLayout>
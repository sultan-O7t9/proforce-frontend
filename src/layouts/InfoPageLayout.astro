---
import MainLayout from "@/layouts/MainLayout.astro";

interface Props {
  title?: string;
}
const { title = "" } = Astro.props;
---

<MainLayout title={title} className="relative" headerTheme="dark">
  <section class="info-page-section pb-24">
    <h1
      class="font-pf-mera-pro text-pf-navy-dark mb-10 px-8 pt-10 text-center text-xl tracking-[10%] uppercase md:mb-24 md:pt-16 md:text-2xl"
    >
      {title}
    </h1>
    <div
      class="max-container font-pf-galano-grotesque flex min-h-screen flex-col gap-6 px-8 md:gap-10 md:px-12 lg:px-[clamp(1rem,6.2vw+1rem,100px)]"
    >
      <slot />
    </div>
  </section>
</MainLayout>

<script>
  const header = document.querySelector(".main-header") as HTMLElement | null;
  const privacyContainer = document.querySelector(
    ".info-page-section",
  ) as HTMLElement | null;

  if (header && privacyContainer) {
    privacyContainer.style.paddingTop =
      header.getBoundingClientRect().height + "px";
  }
</script>

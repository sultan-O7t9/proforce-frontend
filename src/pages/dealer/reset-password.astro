---
import MainButton from "@/components/buttons/MainButton.svelte";
import Input from "@/components/forms/Input.svelte";
import DealerLayout from "@/layouts/DealerLayout.astro";
import { ROUTES } from "@/lib/site";
---

<DealerLayout title="Dealer Portal - Reset Passord">
  <form
    class="font-pf-galano-grotesque flex w-[clamp(280px,100%,480px)] flex-col items-center gap-4.5"
  >
    <!-- Password Field -->
    <Input
      client:load
      name="password"
      placeholder={"New Password"}
      id="password"
      type={"password"}
      label="New Password"
    />
    <Input
      client:load
      name="password"
      placeholder={"Confirm Password"}
      id="confirm-password"
      type={"password"}
      label="Confirm Password"
    />
    <!-- Submit Button (Bonus for completeness) -->
    <MainButton
      client:load
      label="Reset Password"
      href=""
      className="bg-pf-navy hover:text-pf-navy border-pf-navy mt-4 flex min-w-3xs justify-center px-5 py-3.5 text-xs font-semibold tracking-[1%] transition-colors duration-200 hover:bg-transparent sm:w-4/5 md:mt-9 md:px-14 md:py-4 md:text-sm"
    />
  </form>
</DealerLayout>

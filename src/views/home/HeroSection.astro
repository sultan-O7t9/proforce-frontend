---
import MainButton from "@/components/buttons/MainButton.astro"
---
<section class="bg-pf-navy h-screen hero-section-container sticky top-0 bg-cover bg-right  items-start justify-center flex flex-col px-10 md:px-12 lg:px-[clamp(1rem,6.2vw+1rem,100px)] py-5 md:py-8.75 ">
      <div class="max-container w-full flex flex-col gap-20 ">
            <h2 class="flex flex-col text-[45px] font-pf-mera-pro leading-20 tracking-[18%] text-white">
                  <span class="opacity-0 animate-slide-up">
                        PRISTINE.
                  </span>
                  <span class="opacity-0 animate-slide-up">
                        INVISIBLE.
                  </span>
                  <span class="text-transparent opacity-0 animate-slide-up [-webkit-text-stroke:2px_white]">
                        INVINCIBLE.
                  </span>
            </h2>
            <div class="flex justify-start flex-col gap-4 self-start">
                  <MainButton label="Explore Products" showAero/>
                  <MainButton label="Find an Installer" showAero href="" className="md:hidden text-pf-yellow border-pf-yellow" aeroClass="fill-pf-yellow" />
            </div>
      </div>
</section>

<script>
      const header = document.querySelector(".main-header") as (HTMLElement | null)
      const heroSectionCotnainer = document.querySelector(".hero-section-container") as (HTMLElement | null);

      if(header && heroSectionCotnainer) {
            heroSectionCotnainer.style.paddingTop= header.getBoundingClientRect().height+'px';
      }


</script>
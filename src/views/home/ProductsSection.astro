---
import IconResistance from "@/assets/img/icon-resistance.svg";
import IconProtection from "@/assets/img/icon-protection.svg";
import IconHydrophobic from "@/assets/img/icon-hydrophobic.svg";
import IconHealing from "@/assets/img/icon-healing.svg";

const products = [
  {
    id: 1,
    title: "Proforce Phantom",
    thickness: "7 mil",
    warranty: "6 years",
    image: "/images/products/product-phantom.png",
    features: [
      { id: 1, title: "IMPACT RESISTANCE", description: "Defends against rock chips, bug acids, and road debris.", icon: IconResistance },
      { id: 2, title: "UV PROTECTION", description: "Prevents fading and yellowing from harsh sunlight exposure.", icon: IconProtection },
      { id: 3, title: "HYDROPHOBIC", description: "Advanced top coat repels water and makes cleaning effortless.", icon: IconHydrophobic },
      { id: 4, title: "SELF-HEALING", description: "Minor scratches and swirl marks vanish with heat application.", icon: IconHealing },
    ]
  },
  {
    id: 2,
    title: "Proforce Phantom+",
    thickness: "8 mil",
    warranty: "6 years",
    image: "/images/products/product-phantom-plus.png",
    features: [
      { id: 1, title: "UPGRADED IMPACT SHIELD", description: "Thicker 8-mil barrier stops severe rock chips and aggressive road debris.", icon: IconResistance },
      { id: 2, title: "ADVANCED UV BARRIER", description: "Fortified shield prevents fading and yellowing from intense solar exposure.", icon: IconProtection },
      { id: 3, title: "ENHANCED HYDROPHOBICS", description: "Upgraded top coat actively repels water, making daily washing effortless.", icon: IconHydrophobic },
      { id: 4, title: "ACTIVE SELF-HEALING", description: "Scratches and swirl marks vanish rapidly with standard heat application.", icon: IconHealing },
    ]
  },
  {
    id: 3,
    title: "Proforce Apex",
    thickness: "8 mil",
    warranty: "10 years",
    image: "/images/products/product-apex.png",
    features: [
      { id: 1, title: "ELITE IMPACT ARMOR", description: "Maximum 8-mil protection against severe impacts, bug acids, and harsh hazards.", icon: IconResistance },
      { id: 2, title: "ULTIMATE GLOSS", description: "Enhances your factory paint with a dazzling, flawless mirror-like finish.", icon: IconProtection },
      { id: 3, title: "EVOCOAT™ SELF-CLEANING", description: "Extreme hydrophobic technology which instantly repels water, dirt, and chemical contaminants.", icon: IconHydrophobic },
      { id: 4, title: "RAPID SELF-HEALING", description: "Advanced polymer structure erases surface scratches instantly with minimal active heat.", icon: IconHealing },
    ]
  },
];
---

<section class="products-section bg-pf-gohst-white min-h-screen relative z-1 overflow-hidden">
  <div class="max-container h-full pt-20 md:pt-28 pb-16 flex flex-col justify-between">

    <div class="w-full max-w-5xl mx-auto px-4">
      <h4 class="font-pf-mera-pro text-pf-navy text-xs md:text-sm tracking-[25%] px-8 text-center mb-7 md:mb-12 leading-6">THE PROFORCE LINEUP</h4>

      <div class="mx-auto tab-buttons-container border border-pf-navy/50 rounded-[5px] p-1.25 max-w-175 mb-10 md:mb-20">
        <div class="relative flex">
          <!-- Animated Background Pill -->
          <div class="cursor-pointer tab-indicator absolute top-0 bottom-0 left-0 bg-pf-navy rounded-[3px] transition-all duration-300 ease-out z-0 h-full"></div>

          {products.map((product, index) => (
            <button
              class={`cursor-pointer tab-btn w-full relative z-10 px-3 md:px-6 h-14 rounded-full text-xs md:text-sm font-semibold transition-colors duration-300 flex-1 ${index === 0 ? 'text-white' : 'text-gray-65'}`}
              data-index={index}
            >
              {product.title}
            </button>
            <div class={"divider bg-[#9098A6] w-px h-12 self-center "+(index===products.length-1?'hidden':'')}></div>
          ))}
        </div>
      </div>

      <!-- Slider Main Wrapper -->
      <div class="slider-container relative w-full">
        <div class="slides-wrapper grid w-full">
          {products.map((product, index) => {
            const productName = product.title.split(" ")[1];
            return (
              <div
                class={`slide col-start-1 row-start-1 transition-opacity duration-500 ${index === 0 ? 'active opacity-100 z-10' : 'opacity-0 pointer-events-none z-0'}`}
                data-index={index}
              >
                <h5 class={"font-pf-mera-pro text-4xl md:text-8xl text-center tracking-[15%] text-transparent [-webkit-text-stroke:1px_#21314D] text-shadow-[4px_0px_0px_rgba(33,49,77,0.04)] mb-10"}>{productName}</h5>
                <h6 class="flex text-center items-center justify-center gap-4 uppercase font-semibold text-xs md:text-lg tracking-[2%] mb-16">
                  <span>{product.thickness} <span class="font-medium">Thickness</span></span>
                  <span class="block h-1.75 w-1.75 bg-pf-navy opacity-50 rounded-full"></span>
                  <span>{product.warranty} <span class="font-medium">Warranty</span></span>
                </h6>

                <div class="inset-0 w-full grid grid-cols-1 md:grid-cols-[1fr_48.9%_1fr]  gap-4 md:gap-2 ">

                  <!-- Left Features (2 items) -->
                  <div class="flex flex-col justify-between order-2 md:order-1 text-left gap-4">
                    {product.features.slice(0, 2).map((feature) => (
                      <div class="feature-item">
                        <feature.icon class="ml-0.5 mb-5"/>
                        <h3 class="slide-feature-title text-pf-navy font-bold text-base md:text-lg mb-1 font-pf-galano-grotesque">{feature.title}</h3>
                        <p class="slide-feature-desc text-pf-navy opacity-70 text-xs md:text-[13px] leading-5 tracking-normal font-pf-galano-grotesque">{feature.description}</p>
                      </div>
                    ))}
                  </div>

                  <!-- Center Image with Blur Transition -->
                  {/* <div class="slide-image-wrapper flex flex-col items-center justify-center relative w-full order-1 md:order-2 "> */}
                    <img
                      src={product.image}
                      alt={product.title}
                      class={`slide-image order-1 md:order-2 aspect-570/357 object-contain transition-all duration-700 ease-out ${index === 0 ? 'filter-none scale-100' : 'blur-xl scale-110'}`}
                    />

                  {/* </div> */}

                  <!-- Right Features (2 items) -->
                 <div class="flex flex-col justify-between order-3 text-left gap-4">
                    {product.features.slice(0, 2).map((feature) => (
                      <div class="feature-item">
                        <feature.icon class="ml-0.5 mb-5"/>

                        <h3 class="slide-feature-title text-pf-navy font-bold text-base md:text-lg mb-1 font-pf-galano-grotesque">{feature.title}</h3>
                        <p class="slide-feature-desc text-pf-navy opacity-70 text-xs md:text-[13px] leading-5 tracking-normal font-pf-galano-grotesque">{feature.description}</p>
                      </div>
                    ))}
                  </div>

                </div>
              </div>
            )
          })}
        </div>
      </div>
    </div>

    <!-- Dot Navigation (No scaling, color transition only) -->
    <div class="dots-container flex justify-center items-center gap-3 mt-12">
      {products.map((_, index) => (
        <button
          class={`dot w-3 cursor-pointer h-3 rounded-full transition-colors duration-300 border border-pf-yellow ${index === 0 ? 'bg-pf-yellow' : 'bg-transparent hover:bg-gray-100 hover:border-gray-100'}`}
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        ></button>
      ))}
    </div>

  </div>
</section>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabIndicator = document.querySelector('.tab-indicator') as HTMLElement;
    const sliderContainer = document.querySelector('.slider-container');

    let currentIndex = 0;
    const totalSlides = slides.length;
    let isAnimating = false;

    // Position initial background pill indicator under the first tab button
    function updateTabIndicator(index: number) {
      const activeBtn = tabBtns[index] as HTMLElement;
      if (tabIndicator && activeBtn) {
        tabIndicator.style.width = `${activeBtn.offsetWidth}px`;
        tabIndicator.style.left = `${activeBtn.offsetLeft}px`;
      }
    }

    // Set initial position
    updateTabIndicator(0);
    window.addEventListener('resize', () => updateTabIndicator(currentIndex));

    // Cache original strings for feature scramble text
    slides.forEach(slide => {
      const fTitles = slide.querySelectorAll('.slide-feature-title') as NodeListOf<HTMLElement>;
      const fDescs = slide.querySelectorAll('.slide-feature-desc') as NodeListOf<HTMLElement>;;

      fTitles.forEach(el => el.dataset.originalText = el.textContent?.trim() || '');
      fDescs.forEach(el => el.dataset.originalText = el.textContent?.trim() || '');
    });

    function goToSlide(newIndex: number) {
      if (isAnimating || newIndex === currentIndex) return;
      isAnimating = true;

      const currentSlide = slides[currentIndex];
      const nextSlide = slides[newIndex];

      // 1. Handle Slide Visibility & Blur Transitions
      currentSlide.classList.remove('active', 'opacity-100', 'z-10');
      currentSlide.classList.add('opacity-0', 'pointer-events-none', 'z-0');

      const oldImg = currentSlide.querySelector('.slide-image');
      oldImg?.classList.remove('filter-none', 'scale-100');
      oldImg?.classList.add('blur-xl', 'scale-110');

      nextSlide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
      nextSlide.classList.add('active', 'opacity-100', 'z-10');

      const nextImg = nextSlide.querySelector('.slide-image');
      nextImg?.classList.remove('blur-xl', 'scale-110');
      nextImg?.classList.add('filter-none', 'scale-100');

      // 2. Update Tabs & Indicator
      tabBtns[currentIndex].classList.remove('text-white');
      tabBtns[currentIndex].classList.add('text-gray-600');
      tabBtns[newIndex].classList.add('text-white');
      tabBtns[newIndex].classList.remove('text-gray-600');
      updateTabIndicator(newIndex);

      // 3. Update Dots State (Color change only, no scale)
      dots[currentIndex].classList.remove('bg-pf-yellow');
      dots[currentIndex].classList.add('bg-transparent');
      dots[newIndex].classList.add('bg-pf-yellow');
      dots[newIndex].classList.remove('bg-transparent');

      // 4. Trigger Scramble Text Animation on Features
      const nextTitles = nextSlide.querySelectorAll('.slide-feature-title') as NodeListOf<HTMLElement>;
      const nextDescs = nextSlide.querySelectorAll('.slide-feature-desc') as NodeListOf<HTMLElement>;

      nextTitles.forEach(el => el.textContent = "");
      nextDescs.forEach(el => el.textContent = "");

      let completedAnimations = 0;
      const totalAnimations = nextTitles.length + nextDescs.length;

      function checkComplete() {
        completedAnimations++;
        if (completedAnimations >= totalAnimations) {
          currentIndex = newIndex;
          isAnimating = false;
        }
      }

      nextTitles.forEach(el => {
        gsap.to(el, {
          duration: 0.8,
          scrambleText: { text: el.dataset.originalText || '', chars: "uppercase", speed: 0.3 },
          onComplete: checkComplete
        });
      });

      nextDescs.forEach(el => {
        gsap.to(el, {
          duration: 1.0,
          scrambleText: { text: el.dataset.originalText || '', chars: "lowerCase", speed: 0.4 },
          onComplete: checkComplete
        });
      });
    }

    // Event Listeners for Tab Buttons
    tabBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => goToSlide(index));
    });

    // Event Listeners for Dots
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goToSlide(index));
    });

    // Touch / Swipe Support (Mobile & Medium Screens)
    let touchStartX = 0;
    let touchEndX = 0;

    sliderContainer?.addEventListener('touchstart', (e: any) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    sliderContainer?.addEventListener('touchend', (e: any) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeThreshold = 50;
      if (touchStartX - touchEndX > swipeThreshold) {
        let nextIndex = (currentIndex + 1) % totalSlides;
        goToSlide(nextIndex);
      } else if (touchEndX - touchStartX > swipeThreshold) {
        let prevIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        goToSlide(prevIndex);
      }
    }
  });
</script>
---
import MainButton from "@/components/buttons/MainButton.astro";
---

<section class="benefits-section bg-pf-white-v2 relative z-1 -m-2">
<div class="max-container h-full p-12 md:p-20">
      <div class="border border-pf-navy py-6 md:p-12 flex flex-col items-center justify-center gap-6 md:gap-16.5">

            <h4 class=" font-pf-mera-pro text-pf-navy text-xs md:text-sm tracking-[25%] px-4 text-center leading-6">THE PROFORCE DEALER PORTAL</h4>
            <h6 class="font-pf-galano-grotesque text-pf-navy text-2xl md:text-5xl leading-10 md:leading-16 text-center uppercase font-bold max-w-223.5 px-6 md:px-0">ALIGN YOUR BUSINESS WITH THE ULTIMATE PROTECTIVE FORCE</h6>
            <div>

                  <MainButton label="Become an Installer" href="" className="py-3 md:py-5 px-5 md:px-14 font-semibold tracking-[1%] bg-pf-navy transition-colors duration-200 hover:bg-pf-light-navy hover:text-pf-navy border-pf-navy"/>
            </div>
            </div>
</div>
</section>

  </section>
  <section
    class="bg-pf-gohst-white relative z-1 px-8 pt-12 pb-6 text-center md:pt-20 md:pb-20"
  >
    <h3
      class="font-pf-mera-pro text-pf-navy-dark product-title-heading mx-auto mb-5 text-[10px] tracking-[25%] uppercase md:mb-12 md:text-sm"

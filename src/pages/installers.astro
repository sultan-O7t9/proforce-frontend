---

<MainLayout
  title={""}
  className="relative"
  headerTheme="light"
  ctaVariant="filled"
  headerClass="bg-pf-navy-dark border-transparent"
>
  <section class="pb-24">
    <div
      data-padding-top={64}
      class="bg-pf-navy-dark installers-container pb-15"
    >
      <div class="max-container flex flex-col items-center px-8 md:px-12.5">
        <h1
          class="font-pf-mera-pro installer-heading mb-6 text-center text-lg tracking-[10%] text-white uppercase md:mb-12.5 md:text-2xl"
        >
          Find an Installer
        </h1>
        <img
          src={optimizedBg.src}
          alt="Installers Map"
          class="mx-auto h-auto w-full object-cover"
        />
        <h4
          class="font-pf-mera-pro search-heading mt-7 mb-4 text-center text-base tracking-[23%] text-white uppercase md:mt-17 md:mb-8 md:text-xl"
        >
          Search
        </h4>
        <Input
          client:load
          placeholder="Search by city or installer name..."
          name="search"
          id="search"
          inputClass="focus:border-white/75 py-4 md:py-6 rounded-xs border-white/50 text-white pr-14"
          containerClass="w-full max-w-175"
          postIconClass="pr-5"
        >
          <svg
            width="25"
            height="26"
            viewBox="0 0 25 26"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g opacity="0.6">
              <ellipse
                cx="11.7673"
                cy="11.7677"
                rx="11.0173"
                ry="11.0177"
                stroke="white"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></ellipse>
              <path
                d="M19.4307 20.0029L23.7501 24.3113"
                stroke="white"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </g>
          </svg>
        </Input>
      </div>
    </div>
    <div class="max-container flex flex-col gap-3.75">
      <div
        class="bg-pf-yellow/10 px-10 pt-10 pb-8 md:px-14 md:pt-18.5 md:pb-15 lg:px-20"
      >
        <h3
          class="font-pf-galano-grotesque text-pf-black mb-6 text-xl font-bold tracking-[2%] uppercase md:mb-12.5 md:text-[40px]"
        >
          Nearby <span class="font-medium">Installers</span>
        </h3>
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            nearbyInstallers.map((installer) => (
              <InstallerCard {...installer} />
            ))
          }
        </ul>
      </div>
      {
        Object.keys(otherInstallers).map((country) => (
          <div class="bg-pf-gohst-white px-10 pt-10 pb-8 md:px-14 md:pt-18.5 md:pb-15 lg:px-20">
            <h3 class="font-pf-galano-grotesque text-pf-black mb-6 text-xl font-bold tracking-[2%] uppercase md:mb-12.5 md:text-[40px]">
              {country.replaceAll("_", " ")}
            </h3>
            <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {otherInstallers[country].map((installer) => (
                <InstallerCard {...installer} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</MainLayout>

<script>
  import { setupWordScrollAnimation } from "@/lib/gsap";

  setupWordScrollAnimation(".installer-heading");
  setupWordScrollAnimation(".search-heading");
  const header = document.querySelector(".main-header") as HTMLElement | null;
  const heroSectionCotnainer = document.querySelector(
    ".installers-container",
  ) as HTMLElement | null;

  if (header && heroSectionCotnainer) {
    heroSectionCotnainer.style.paddingTop =
      header.getBoundingClientRect().height +
      (Number(heroSectionCotnainer.dataset.paddingTop) ?? 0) +
      "px";
  }
</script>
